{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "powershell -NoProfile -File tools/docs_reminder.ps1",
            "timeout": 30,
            "statusMessage": "Checking the docs"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(*git commit*)",
            "command": "powershell -NoProfile -File tools/docs_reminder.ps1",
            "timeout": 30,
            "statusMessage": "Checking the docs"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I tools/hooks/claude_hooks.py commands",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/[Mm]akefile)",
            "command": "python -I tools/hooks/claude_hooks.py makefile",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Write(**/[Mm]akefile)",
            "command": "python -I tools/hooks/claude_hooks.py makefile",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -I tools/hooks/claude_hooks.py line-endings",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I tools/hooks/claude_hooks.py games",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
