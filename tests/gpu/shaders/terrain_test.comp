#version 450
#extension GL_GOOGLE_include_directive : require

// Runs terrain.glsl's functions on the cases terrain_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "terrain.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    vec4 a = testInput(0);

    if (function == GPU_TEST_TERRAIN_MORPH) {
        testOutput(0, vec4(terrainMorph(a.x, a.y, a.z)));
    } else if (function == GPU_TEST_TERRAIN_MORPH_GRID) {
        testOutput(0, vec4(morphGridCoordinate(a.xy, a.z), 0.0, 0.0));
    } else if (function == GPU_TEST_TERRAIN_BILINEAR) {
        vec4 b = testInput(1);
        testOutput(0, vec4(terrainBilinear(a.x, a.y, a.z, a.w, b.x, b.y)));
    } else if (function == GPU_TEST_TERRAIN_TRIANGLE) {
        vec4 b = testInput(1);
        testOutput(0, vec4(terrainTriangleHeight(a.x, a.y, a.z, a.w, b.x, b.y)));
    } else if (function == GPU_TEST_TERRAIN_CLUSTER_BOX) {
        // Inputs: the patch's placement (corner x, z, size, quads), its morph (start, end, spacing), the footprint.
        TerrainPatch landPatch;
        landPatch.placement = a;
        landPatch.morph = testInput(1);
        landPatch.uv = vec4(0.0);
        testOutput(0, terrainClusterBox(landPatch, testInput(2)));
    } else if (function == GPU_TEST_TERRAIN_BOX_SPHERE) {
        // Inputs: the box, (lowest, highest).
        testOutput(0, terrainBoxSphere(a, testInput(1).xy));
    }
}
