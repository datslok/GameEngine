#version 450
#extension GL_GOOGLE_include_directive : require

// Runs cascades.glsl's functions on the cases cascades_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "cascades.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    vec4 a = testInput(0);

    if (function == GPU_TEST_CASCADE_EDGE_DISTANCE) {
        testOutput(0, vec4(cascadeEdgeDistance(a.xyz, a.w)));
    } else if (function == GPU_TEST_CASCADE_BLEND) {
        testOutput(0, vec4(cascadeBlendWeight(a.x, a.y), cascadeDitherKeeps(a.z, a.w) ? 1.0 : 0.0, 0.0, 0.0));
    } else if (function == GPU_TEST_SUN_SHADOW_BIAS) {
        testOutput(0, vec4(sunShadowBias(a.x, a.y)));
    }
}
