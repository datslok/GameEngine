#version 450
#extension GL_GOOGLE_include_directive : require

// Runs card_thinning.glsl's functions on the cases card_thinning_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "card_thinning.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    vec4 a = testInput(0);

    if (function == GPU_TEST_THINNED_SHARE) {
        float share = thinnedShare(a.xyz, a.w);
        testOutput(0, vec4(share, thinningError(a.xyz, share), 0.0, 0.0));
    } else if (function == GPU_TEST_THINNED_CARD) {
        vec4 corner = testInput(1);
        vec4 anchor = testInput(2);
        vec3 moved = thinnedPosition(corner.xyz, anchor.xyz, thinnedCardScale(a.xyz, corner.w, a.w));
        testOutput(0, vec4(moved, cardPresence(corner.w, a.w)));
    }
}
