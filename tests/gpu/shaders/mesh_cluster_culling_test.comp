#version 450
#extension GL_GOOGLE_include_directive : require

// Runs mesh_cluster_culling.glsl's functions on the cases mesh_cluster_culling_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "mesh_cluster_culling.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    if (function == GPU_TEST_MESH_CLUSTER_TASKS) {
        // Input: (a run's count, a workgroup's x, its y). Output: (the run's workgroups x y z, the workgroup's survivor).
        vec4 a = testInput(0);
        uvec3 groups = meshClusterTaskGroups(uint(a.x));
        testOutput(0, vec4(vec3(groups), float(meshClusterTaskIndex(uvec3(uint(a.y), uint(a.z), 0u)))));
        return;
    }

    if (function == GPU_TEST_MESH_CLUSTER_SCREEN_BOX) {
        // Inputs: the sphere, the view-projection's four columns, (width, height, levels). Outputs: the box, (nearest
        // depth, on screen), its pixels, (their pyramid level).
        vec4 size = testInput(5);
        MeshClusterScreenBox box = meshClusterScreenBox(testInput(0), mat4(testInput(1), testInput(2), testInput(3), testInput(4)), size.xy);
        ivec4 pixels = meshClusterBoxPixels(box.box, ivec2(size.xy));
        testOutput(0, box.box);
        testOutput(1, vec4(box.nearestDepth, box.onScreen ? 1.0 : 0.0, 0.0, 0.0));
        testOutput(2, vec4(pixels));
        testOutput(3, vec4(float(meshClusterPyramidLevel(pixels, int(size.z))), 0.0, 0.0, 0.0));
        return;
    }

    if (function == GPU_TEST_FAR_LEAF_SCREEN_BOX) {
        // Inputs: the leaf's five clip positions, (width, height). Outputs: the box, (nearest depth with its margin, on screen).
        vec4 clips[FAR_LEAF_VERTICES];

        for (int vertex = 0; vertex < FAR_LEAF_VERTICES; ++vertex) {
            clips[vertex] = testInput(uint(vertex));
        }

        MeshClusterScreenBox box = farLeafScreenBox(clips, testInput(uint(FAR_LEAF_VERTICES)).xy);
        testOutput(0, box.box);
        testOutput(1, vec4(box.nearestDepth, box.onScreen ? 1.0 : 0.0, 0.0, 0.0));
        return;
    }

    if (function == GPU_TEST_MESH_CLUSTER_KEPT) {
        // Inputs: the cluster's sphere, its cone (apex, cutoff), its axis, the model's four columns, (the entry's
        // thinned bit, the record's flags, the view's sway flag, its fade end), (terrain patch, kind, liana), the
        // record's bounds, the eye, the frustum's six planes, the own sphere, the parent sphere, (own error, parent
        // error, pixel error, level flags), (the pose's bound, posed), the pose's sphere. Outputs: (kept, seen whole,
        // faces away from the eye brought into the mesh, largest scale), the world sphere, (in the cut, own error's
        // pixels, parent error's pixels).
        MeshCluster cluster;
        cluster.sphere = testInput(0);
        cluster.cone = testInput(1);
        cluster.axis = testInput(2).xyz;
        cluster.firstVertex = 0u;
        cluster.firstTriangleWord = 0u;
        cluster.counts = 0u;
        cluster.meshFirstVertex = 0u;
        cluster.ownSphere = testInput(17);
        cluster.parentSphere = testInput(18);
        vec4 errors = testInput(19);
        cluster.ownError = errors.x;
        cluster.parentError = errors.y;
        cluster.level = 0u;
        cluster.bones = uvec2(0xFFFFFFFFu);
        cluster.moreBones = uvec2(0xFFFFFFFFu);
        cluster.unused = uvec2(0u);

        InstanceData instance;
        instance.model = mat4(testInput(3), testInput(4), testInput(5), testInput(6));
        instance.normalMatrix = mat4(1.0);
        instance.handedness = vec4(1.0);
        vec4 kinds = testInput(8);
        instance.material = uvec4(0u, 0u, uint(kinds.x), uint(kinds.y));
        instance.sway = vec4(-1.0);
        instance.hanging = uvec4(0u, 0u, 0u, uint(kinds.z));
        instance.levelSphere = vec4(0.0);

        vec4 flags = testInput(7);
        uint entry = flags.x != 0.0 ? DRAW_LIST_THINNED_BIT : 0u;
        CullRecord record;
        record.bounds = testInput(9);
        record.levelSphere = record.bounds;
        record.flags = uint(flags.y);
        record.mesh = 0u;
        record.hiddenBelowError = 0.0;
        record.shadowCascades = 0;

        CameraCull view;
        view.levels.eye = testInput(10);
        view.levels.pixelError = errors.z;
        view.levels.flags = uint(errors.w);
        view.flags = uint(flags.z);
        view.swayFadeEnd = flags.w;

        for (int plane = 0; plane < 6; ++plane) {
            view.frustum.planes[plane] = testInput(11u + uint(plane));
        }

        float determinant = meshClusterDeterminant(instance.model);
        bool away = determinant > 0.0 && meshClusterFacesAway(cluster, meshClusterEyeInMesh(instance.model, view.levels.eye.xyz, determinant));
        vec4 posing = testInput(20);
        MeshClusterPose pose = MeshClusterPose(posing.x != 0.0, posing.y != 0.0, testInput(21));
        testOutput(0, vec4(meshClusterKept(cluster, instance, entry, record, view, pose) ? 1.0 : 0.0,
                           meshClusterSeenWhole(instance, entry, record, view, pose) ? 1.0 : 0.0,
                           away ? 1.0 : 0.0, meshClusterLargestScale(instance.model)));
        testOutput(1, meshClusterWorldSphere(cluster, instance.model));
        testOutput(2, vec4(meshClusterInCut(cluster, instance.model, view.levels) ? 1.0 : 0.0,
                           meshClusterErrorPixels(cluster.ownSphere, cluster.ownError, instance.model, view.levels),
                           meshClusterErrorPixels(cluster.parentSphere, cluster.parentError, instance.model, view.levels), 0.0));
    }
}
