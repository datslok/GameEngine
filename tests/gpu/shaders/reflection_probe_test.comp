#version 450
#extension GL_GOOGLE_include_directive : require

// Runs reflection_probe.glsl's functions on the cases reflection_probe_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "reflection_probe.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    if (function == GPU_TEST_PROBE_CUBE) {
        // Inputs: (face, s, t, view distance).
        vec4 texel = testInput(0);
        vec3 direction = cubeTexelDirection(int(texel.x + 0.5), texel.yz);
        testOutput(0, vec4(direction, probeRadialDistance(texel.w, normalize(direction))));
    } else if (function == GPU_TEST_PROBE_PARALLAX) {
        // Inputs: (position, stored distance), (direction, t), (near side, far side, angle, cube size).
        vec4 position = testInput(0);
        vec4 direction = testInput(1);
        vec4 distances = testInput(2);
        testOutput(0, vec4(parallaxDirection(position.xyz, direction.xyz, direction.w),
                           parallaxMismatch(position.xyz, direction.xyz, max(direction.w, 0.0), position.w)));
        int side = int(distances.w);
        ivec3 cell = cubeCellOf(normalize(position.xyz), side);
        testOutput(1, vec4(parallaxConfidence(distances.x, distances.y),
                           cubeCellExit(position.xyz, direction.xyz, 0.0, cell, side, position.w * 10.0),
                           probeTexelAngle(distances.w), probeViewConfidence(distances.z, distances.w)));
        testOutput(3, vec4(vec3(cell), 0.0));
        testOutput(2, vec4(probeStartLift(position.xyz, direction.xyz, distances.w), probeEdgeConfidence(distances.y / 50.0),
                           probeDistanceSpread(vec4(distances.xy, position.w, distances.x * 0.9)), 0.0));
    } else if (function == GPU_TEST_PROBE_LEVELS) {
        // Inputs: (roughness, levels, pdf, samples), (size, confidence, 0, 0), (stand-in), (specular albedo), (light).
        vec4 levels = testInput(0);
        vec4 blend = testInput(1);
        testOutput(0, vec4(probeRoughnessLevel(levels.x, levels.y), prefilterSourceLevel(levels.z, levels.w, blend.x), 0.0, 0.0));
        testOutput(1, vec4(blendedStandIn(testInput(2).rgb, testInput(3).rgb, testInput(4).rgb, blend.y), 0.0));
    }
}
