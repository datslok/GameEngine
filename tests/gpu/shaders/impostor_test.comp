#version 450
#extension GL_GOOGLE_include_directive : require

// Runs impostor.glsl's functions on the cases impostor_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "impostor.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    vec4 a = testInput(0);

    if (function == GPU_TEST_IMPOSTOR_ENCODE) {
        testOutput(0, vec4(hemiOctahedralEncode(a.xyz), 0.0, 0.0));
    } else if (function == GPU_TEST_IMPOSTOR_DECODE) {
        testOutput(0, vec4(hemiOctahedralDecode(a.xy), 0.0));
    } else if (function == GPU_TEST_IMPOSTOR_FRAME_UV) {
        vec4 b = testInput(1);
        testOutput(0, vec4(impostorFrameUv(a.xyz, impostorFrameDirection(b.xy, b.z)), 0.0, 0.0));
    }
}
