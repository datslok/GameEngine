#version 450
#extension GL_GOOGLE_include_directive : require

// Runs wind_bones.glsl's, quat.glsl's and bone_poses.glsl's functions on the cases wind_bones_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "bone_poses.glsl"
#include "wind_bones.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    vec4 a = testInput(0);
    vec4 b = testInput(1);

    if (function == GPU_TEST_QUAT) {
        vec4 c = testInput(2);
        testOutput(0, quatMultiply(a, b));
        testOutput(1, vec4(quatRotate(a, c.xyz), 0.0));
        testOutput(2, quatFromRotationVector(testInput(3).xyz));
    } else if (function == GPU_TEST_WIND_BONE_SHARE) {
        testOutput(0, vec4(windBoneShare(a.x, a.y, a.z, a.w, b.x, b.y)));
    } else if (function == GPU_TEST_WIND_BRANCH) {
        testOutput(0, vec4(windBranchHertz(a.x, a.y, a.z, a.w, b.x), windBranchPhase(uint(b.y), uint(b.z)), 0.0, 0.0));
    } else if (function == GPU_TEST_WIND_BONE_TURN) {
        vec4 c = testInput(2);
        testOutput(0, vec4(windBoneTurn(a.xyz, a.w, b.xy, b.z, b.w, c.x, c.yz), 0.0));
    } else if (function == GPU_TEST_WIND_BONE_POSE) {
        WindBonePose parent = WindBonePose(a, b.xyz);
        vec4 place = testInput(4);
        WindBonePose pose = windBonePose(parent, testInput(2).xyz, testInput(3).xyz);
        testOutput(0, pose.turn);
        testOutput(1, vec4(pose.shift, 0.0));
        testOutput(2, vec4(windBlendedPlace(pose, parent, place.w, place.xyz), 0.0));
        testOutput(3, vec4(windBlendedDirection(pose, parent, place.w, testInput(5).xyz), 0.0));
    } else if (function == GPU_TEST_WIND_RIGID_POSE) {
        vec4 foot = testInput(4);
        WindBonePose rigid = windRigidPose(WindBonePose(testInput(2), testInput(3).xyz), WindBonePose(a, b.xyz), foot.w, foot.xyz);
        testOutput(0, rigid.turn);
        testOutput(1, vec4(rigid.shift, 0.0));
    } else if (function == GPU_TEST_WIND_PLANT_POINT) {
        testOutput(0, vec4(windPlantPoint(a.xyz, b.xyz, b.w, testInput(2).x), 0.0));
    } else if (function == GPU_TEST_WIND_PLANT_POINT_OFFSET) {
        vec4 world = testInput(4);
        vec4 foot = testInput(5);
        vec3 moved = windPlantPointOffset(WindBonePose(testInput(2), testInput(3).xyz), WindBonePose(a, b.xyz), world.w, world.xyz, foot.xyz, foot.w,
                                          testInput(6).x);
        testOutput(0, vec4(moved, 0.0));
    } else if (function == GPU_TEST_WIND_BONE_OWN_TURN) {
        vec4 c = testInput(2);
        vec4 d = testInput(3);
        vec4 e = testInput(4);
        testOutput(0, vec4(windBoneOwnTurn(a.xyz, b.xyz, a.w, uint(b.w), c.x, c.y, d.xyz, uint(d.w), c.zw, e.x, testInput(5), testInput(6)), 0.0));
    } else if (function == GPU_TEST_BONE_LEAN_IN_PLANT) {
        testOutput(0, vec4(windLeanInPlant(a.xy, a.z), 0.0, 0.0));
    } else if (function == GPU_TEST_BONE_CLAIM) {
        uint firstPose = boneTreeFirstPose(floatBitsToUint(b.x), floatBitsToUint(b.y), floatBitsToUint(b.z));
        testOutput(0, vec4(boneFootInReach(a.xyz, testInput(2).xyz, a.w) ? 1.0 : 0.0, uintBitsToFloat(firstPose), uintBitsToFloat(boneTreeSeed(b.w)), 0.0));
    } else if (function == GPU_TEST_BONE_SCREEN) {
        // Inputs: the foot and scale; the turn, still and full shares and the screen's scale; the skeleton's sphere; the eye.
        vec4 placed = boneTreeSphere(a.xyz, a.w, b.x, testInput(2));
        float share = boneScreenShare(placed, testInput(3).xyz, b.w);
        testOutput(0, placed);
        testOutput(1, vec4(share, boneScreenFade(share, b.y, b.z), boneTreeWanted(share, b.y) ? 1.0 : 0.0, 0.0));
    } else if (function == GPU_TEST_BONE_CLAIMED_TREE) {
        uvec4 words = floatBitsToUint(a);
        uint tree = boneClaimedTree(words.x, words.y, words.z);
        uint bone = floatBitsToUint(b.x);
        testOutput(0, vec4(uintBitsToFloat(tree), uintBitsToFloat(bonePoseSlot(words.w, bone, false)), uintBitsToFloat(bonePoseSlot(words.w, bone, true)), 0.0));
    } else if (function == GPU_TEST_WIND_SPHERES) {
        WindBonePose pose = WindBonePose(a, b.xyz);
        vec4 first = testInput(2);
        testOutput(0, windPosedSphere(pose, first));
        testOutput(1, windSphereUnion(first, testInput(3)));
        // The same pose's moves for a bone from the first centre to the second, and a tree's move at the second's radius.
        vec2 moves = windPoseMoves(pose, first.xyz, testInput(3).xyz);
        testOutput(2, vec4(moves, windTreeMove(moves, testInput(3).w), 0.0));
        // The first sphere blended between the pose and one only shifting it to the second centre.
        testOutput(3, windBlendedSphere(pose, WindBonePose(vec4(0.0, 0.0, 0.0, 1.0), testInput(3).xyz), first));
    }
}
