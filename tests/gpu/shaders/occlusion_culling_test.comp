#version 450
#extension GL_GOOGLE_include_directive : require

// Runs occlusion_culling.glsl's functions on the cases occlusion_culling_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "occlusion_culling.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    if (function == GPU_TEST_OCCLUSION_SPHERE) {
        // Inputs: (view-space centre, radius), (scale x, scale y, near plane, 0), (width, height, levels, 0),
        // (depth constant, depth per inverse distance, 0, 0). Outputs: the rectangle, then (projected, nearest depth,
        // level, 0).
        vec4 sphere = testInput(0);
        vec4 lens = testInput(1);
        vec4 screen = testInput(2);
        vec4 depthRow = testInput(3);
        ivec4 rect;
        bool projected = occlusionSphereRect(sphere.xyz, sphere.w, lens.xy, lens.z, ivec2(screen.xy), rect);
        testOutput(0, vec4(rect));
        testOutput(1, vec4(projected ? 1.0 : 0.0, occlusionNearestDepth(sphere.z, sphere.w, depthRow.x, depthRow.y),
                           float(occlusionLevel(rect, int(screen.z))), 0.0));
    }
}
