#version 450
#extension GL_GOOGLE_include_directive : require

// Runs dither.glsl's functions on the cases dither_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "dither.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    vec4 a = testInput(0);

    if (function == GPU_TEST_LINEAR_TO_SRGB) {
        testOutput(0, vec4(linearToSrgb(a.rgb), 0.0));
    } else if (function == GPU_TEST_SRGB_TO_LINEAR) {
        testOutput(0, vec4(srgbToLinear(a.rgb), 0.0));
    } else if (function == GPU_TEST_INTERLEAVED_GRADIENT_NOISE) {
        testOutput(0, vec4(interleavedGradientNoise(a.xy)));
    } else if (function == GPU_TEST_DITHER_FOR_EIGHT_BITS) {
        testOutput(0, vec4(ditherForEightBits(a.rgb, a.a), 0.0));
    }
}
