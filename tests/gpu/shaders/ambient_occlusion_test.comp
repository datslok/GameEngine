#version 450
#extension GL_GOOGLE_include_directive : require

// Runs ambient_occlusion.glsl's functions on the cases ambient_occlusion_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "ambient_occlusion.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    if (function == GPU_TEST_AMBIENT_OCCLUSION) {
        // Inputs: (normal, radius), (toCamera, falloff), (direction, distance), (offset, noise), (centre, roughness),
        // (before, nDotV), (before next, visibility), (after, footprint), (after next, view distance), (albedo, horizon
        // cosine 0), (horizon cosine 1, screen radius, step, count).
        vec4 normal = testInput(0);
        vec4 toCamera = testInput(1);
        vec4 direction = testInput(2);
        vec4 offset = testInput(3);
        vec4 centre = testInput(4);
        vec4 before = testInput(5);
        vec4 beforeNext = testInput(6);
        vec4 after = testInput(7);
        vec4 afterNext = testInput(8);
        vec4 albedo = testInput(9);
        vec4 last = testInput(10);
        AoSlice slice = aoSlice(normal.xyz, toCamera.xyz, direction.xyz);

        testOutput(0, vec4(occluderWeight(direction.w, normal.w, toCamera.w), lowHorizonCosine(slice, 0), lowHorizonCosine(slice, 1),
                           horizonCosine(offset.xyz, toCamera.xyz)));
        testOutput(1, vec4(slice.axis, slice.normalAngle));
        testOutput(2, vec4(slice.projectedLength, sliceVisibility(slice, albedo.w, last.x), aoScreenRadius(normal.w, after.w, afterNext.w),
                           aoSampleDistance(int(last.z), int(last.w), offset.w, last.y)));

        vec3 step = surfaceStep(centre.xyz, before.xyz, beforeNext.xyz, after.xyz, afterNext.xyz);
        testOutput(3, vec4(step, specularOcclusion(before.w, beforeNext.w, centre.w)));
        testOutput(4, vec4(depthNormal(centre.xyz, step, offset.xyz), aoNormalWeight(normal.xyz, toCamera.xyz)));
        testOutput(5, vec4(multiBounceOcclusion(beforeNext.w, albedo.rgb), surfaceVisibility(beforeNext.w, centre.w, toCamera.w)));
        testOutput(6, vec4(sectorShare(slice, albedo.w, 0), sectorShare(slice, last.x, 1), float(bitCount(sectorMask(before.w, beforeNext.w, offset.w))), 0.0));
        testOutput(7, vec4(gatheredSampleLight(albedo.rgb, beforeNext.w), aoSampleLevel(int(last.z), int(last.w), offset.w, last.y)));
    }

    if (function == GPU_TEST_AO_HISTORY) {
        // Inputs: the reprojection's four columns, (pixel, depth, view depth), (size, previous age, history frames),
        // (current), (history light), (expected depth, stored depth, share, tap).
        mat4 reprojection = mat4(testInput(0), testInput(1), testInput(2), testInput(3));
        vec4 point = testInput(4);
        vec4 frame = testInput(5);
        vec4 current = testInput(6);
        vec4 historyLight = testInput(7);
        vec4 tap = testInput(8);
        float age = aoHistoryAge(frame.z, int(frame.w));

        testOutput(0, aoPreviousPlace(reprojection, point.xy, point.z, point.w, frame.xy));
        testOutput(1, vec4(age, aoCurrentShare(age), aoHistoryTapKept(tap.x, tap.y, tap.z) ? 1.0 : 0.0, aoTapWeight(fract(point.xy), int(tap.w))));
        testOutput(2, accumulatedAo(current, historyLight, age));
        vec3 planeNormal = normalize(historyLight.xyz + vec3(0.1));
        testOutput(3, vec4(aoNoise(current.xyz * 0.12, int(tap.w * 300.0)), aoPlaneWeight(planeNormal, current.xyz, historyLight.xyz, tap.x, tap.z)));
        testOutput(4, vec4(aoDepthRay(reprojection, point.xy, frame.xy), atrousKernelWeight(int(tap.w * 4.0) % 5 - 2, int(tap.w * 13.0) % 5 - 2)));
        testOutput(5, vec4(aoLuminance(current.rgb), aoLightChanged(current.x, historyLight.x, historyLight.x * historyLight.x + current.w * 0.01, 3.0) ? 1.0 : 0.0, 0.0, 0.0));
    }
}
