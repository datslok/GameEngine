#version 450
#extension GL_GOOGLE_include_directive : require

// Runs ddgi.glsl's functions on the cases ddgi_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "ddgi.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    vec4 first = testInput(0);
    vec4 second = testInput(1);
    vec4 third = testInput(2);
    vec4 fourth = testInput(3);

    if (function == GPU_TEST_OCTAHEDRAL) {
        testOutput(0, vec4(octahedralEncode(first.xyz), 0.0, 0.0));
        testOutput(1, vec4(octahedralDecode(second.xy), 0.0));
    } else if (function == GPU_TEST_PROBE_TEXELS) {
        int side = int(first.z);
        testOutput(0, vec4(probeTexelDirection(ivec2(first.xy), side), float(probeBorderTexelCount(side))));
        testOutput(1, vec4(vec2(probeBorderSource(ivec2(second.xy), side)), vec2(probeBorderTexel(int(first.w), side))));
    } else if (function == GPU_TEST_PROBE_RAYS) {
        vec3 rotation[3] = vec3[3](second.xyz, third.xyz, fourth.xyz);
        testOutput(0, vec4(sphericalFibonacci(int(first.x), int(first.y)), 0.0));
        testOutput(1, vec4(probeRayDirection(int(first.x), int(first.y), int(first.z), rotation), 0.0));
    } else if (function == GPU_TEST_PROBE_WEIGHTS) {
        testOutput(0, vec4(irradianceRayWeight(first.xyz, second.xyz), distanceRayWeight(first.xyz, second.xyz),
                           distanceForUpdate(third.x, third.y), 0.0));
    } else if (function == GPU_TEST_PROBE_BLENDING) {
        testOutput(0, vec4(blendProbeValue(first.xyz, second.xyz, third.x), 0.0));
        testOutput(1, vec4(blendProbeValue(first.xy, second.xy, third.x), 0.0, 0.0));
    } else if (function == GPU_TEST_PROBE_GRID) {
        ivec3 counts = ivec3(third.xyz);
        int index = int(third.w);
        int side = int(fourth.w);
        ivec3 scroll = ivec3(testInput(4).xyz);
        ivec3 grid = probeGridCoord(counts, scroll, index);
        testOutput(0, vec4(probePosition(first.xyz, second.xyz, counts, scroll, index), 0.0));
        testOutput(1, vec4(vec2(probeTileOrigin(counts, index, side)), probeAtlasUv(counts, index, fourth.xyz, side)));
        testOutput(2, vec4(vec3(grid), float(probeSlot(counts, scroll, grid))));
    } else if (function == GPU_TEST_PROBE_REACH) {
        testOutput(0, vec4(probeNearLight(first.xyz, second.xyz, first.w, second.w) ? 1.0 : 0.0));
    } else if (function == GPU_TEST_PROBE_ADAPTIVE) {
        AdaptiveProbeTexel texel = adaptiveProbeBlend(AdaptiveProbeTexel(first.xyz, first.w, second.xyz, second.w), third.xyz,
                                                      fourth.x, fourth.y, fourth.z);
        testOutput(0, vec4(texel.stored, texel.history));
        testOutput(1, vec4(texel.recent, texel.noise));
        testOutput(2, vec4(probeLuminance(third.xyz)));
    } else if (function == GPU_TEST_PROBE_RESTART) {
        vec4 sharing = testInput(4);
        vec4 check = testInput(5);
        AdaptiveProbeTexel texel = adaptiveProbeUpdate(AdaptiveProbeTexel(first.xyz, first.w, second.xyz, second.w), third.xyz,
                                                       fourth.x, fourth.y, fourth.z, int(fourth.w), check);
        testOutput(0, vec4(texel.stored, texel.history));
        testOutput(1, vec4(texel.recent, texel.noise));
        testOutput(2, vec4(eventProbeSharingWeight(sharing.x, sharing.y, int(fourth.w), fourth.x), restartedProbeKeep(fourth.x, sharing.z, check.y, fourth.w),
                           0.0, 0.0));
    } else if (function == GPU_TEST_PROBE_SHARING) {
        vec3 neighbours[DDGI_SHARE_NEIGHBOURS];
        bool visible[DDGI_SHARE_NEIGHBOURS];

        for (int neighbour = 0; neighbour < DDGI_SHARE_NEIGHBOURS; ++neighbour) {
            vec4 packed = testInput(1 + neighbour);
            neighbours[neighbour] = packed.xyz;
            visible[neighbour] = packed.w > 0.5;
        }

        vec4 lookup = testInput(7);
        vec4 distances = testInput(8);
        vec3 rotation[3] = vec3[3](testInput(9).xyz, testInput(10).xyz, testInput(11).xyz);
        vec3 turn[3] = vec3[3](testInput(12).xyz, testInput(13).xyz, testInput(14).xyz);
        vec4 ray = testInput(15);
        testOutput(0, vec4(sharedProbeValue(first.xyz, neighbours, visible, first.w), 0.0));
        testOutput(1, vec4(vec2(probeDirectionTexel(lookup.xyz, int(lookup.w))), probesSeeEachOther(distances.x, distances.y) ? 1.0 : 0.0, 0.0));
        testOutput(2, vec4(probeRayDirection(int(ray.x), int(ray.y), int(ray.z), rotation, turn), 0.0));
    }
}
