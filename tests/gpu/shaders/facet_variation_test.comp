#version 450
#extension GL_GOOGLE_include_directive : require

// Runs facet_variation.glsl's functions on the cases facet_variation_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "facet_variation.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    vec4 a = testInput(0);

    if (function == GPU_TEST_FACET_TONE) {
        testOutput(0, vec4(facetToneScale(a.xy, a.z), 0.0, 0.0, 0.0));
    } else if (function == GPU_TEST_FACET_ROUGHNESS) {
        testOutput(0, vec4(facetRoughness(a.w, a.xy, a.z), 0.0, 0.0, 0.0));
    }
}
