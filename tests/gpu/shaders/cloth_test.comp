#version 450
#extension GL_GOOGLE_include_directive : require

// Runs cloth.glsl's functions on the cases cloth_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "cloth.glsl"
#include "deform.glsl"

// A body from three inputs: (kind, radius), a, b.
ClothCollider testCollider(uint first) {
    ClothCollider collider;
    collider.kind = uint(testInput(first).x);
    collider.radius = testInput(first).y;
    collider.unused = vec2(0.0);
    collider.a = testInput(first + 1u);
    collider.b = testInput(first + 2u);
    return collider;
}

// A block from two inputs: its diagonal, then the rest.
ClothBlock testBlock(uint first) {
    ClothBlock block;
    block.diagonal = testInput(first).xyz;
    block.offDiagonal = testInput(first + 1u).xyz;
    return block;
}

// A term's results: the force, then the block's diagonal and the rest.
void testTermOutputs(vec3 force, ClothBlock block) {
    testOutput(0, vec4(force, 0.0));
    testOutput(1, vec4(block.diagonal, 0.0));
    testOutput(2, vec4(block.offDiagonal, 0.0));
}

// The per-point terms' cases: a force and block to add to (inputs 0 to 2), then the term's own numbers (3 to 5).
bool runPointTerm() {
    vec3 force = testInput(0).xyz;
    ClothBlock block = testBlock(1u);
    if (function == GPU_TEST_CLOTH_INERTIA_TERM) {
        clothInertiaTerm(force, block, testInput(3).xyz, testInput(4).xyz, testInput(4).w);
    } else if (function == GPU_TEST_CLOTH_EDGE_TERM) {
        clothEdgeTerm(force, block, testInput(3).xyz, testInput(4).xyz, testInput(4).w, testInput(5).x);
    } else if (function == GPU_TEST_CLOTH_ISOMETRIC_HINGE_TERM) {
        clothIsometricHingeTerm(force, block, testInput(3).xyz, testInput(3).w, testInput(4).x);
    } else if (function == GPU_TEST_CLOTH_HINGE_ANGLE_TERM) {
        clothHingeAngleTerm(force, block, testInput(3).xyz, testInput(3).w, testInput(4).x);
    } else if (function == GPU_TEST_CLOTH_HAND_TERM) {
        clothHandTerm(force, block, testInput(3).xyz, testInput(4).xyz, testInput(4).w);
    } else {
        return false;
    }
    testTermOutputs(force, block);
    return true;
}

void main() {
    if (outsideTheCases()) {
        return;
    }
    if (runPointTerm()) {
        return;
    }

    if (function == GPU_TEST_CLOTH_PREDICT) {
        vec4 point = testInput(0);
        vec3 velocity = testInput(1).xyz;
        vec4 gainAndSeconds = testInput(2);
        vec3 previous;
        clothPredict(point, velocity, previous, gainAndSeconds.xyz, gainAndSeconds.w);
        testOutput(0, point);
        testOutput(1, vec4(velocity, 0.0));
        testOutput(2, vec4(previous, 0.0));
    } else if (function == GPU_TEST_CLOTH_PIN_POSITION) {
        ClothPin pin;
        pin.start = testInput(0);
        pin.target = testInput(1);
        vec4 steps = testInput(2);
        testOutput(0, vec4(clothPinPosition(pin, uint(steps.x), uint(steps.y)), 0.0));
    } else if (function == GPU_TEST_CLOTH_STRETCH) {
        vec4 first = testInput(0);
        vec4 second = testInput(1);
        clothStretch(first, second, testInput(2).x, testInput(2).y);
        testOutput(0, first);
        testOutput(1, second);
    } else if (function == GPU_TEST_CLOTH_ISOMETRIC_BEND) {
        vec4 wing0 = testInput(0);
        vec4 wing1 = testInput(1);
        vec4 edgeStart = testInput(2);
        vec4 edgeEnd = testInput(3);
        vec4 numbers = testInput(5);
        clothIsometricBend(wing0, wing1, edgeStart, edgeEnd, testInput(4), numbers.x, numbers.y, numbers.z);
        testOutput(0, wing0);
        testOutput(1, wing1);
        testOutput(2, edgeStart);
        testOutput(3, edgeEnd);
    } else if (function == GPU_TEST_CLOTH_HINGE_STATE) {
        ClothHinge hinge = clothHingeState(testInput(0).xyz, testInput(1).xyz, testInput(2).xyz, testInput(3).xyz);
        testOutput(0, vec4(hinge.angle));
        for (uint point = 0u; point < 4u; ++point) {
            testOutput(1u + point, vec4(hinge.gradient[point], 0.0));
        }
    } else if (function == GPU_TEST_CLOTH_HINGE_BEND) {
        vec4 wing0 = testInput(0);
        vec4 wing1 = testInput(1);
        vec4 edgeStart = testInput(2);
        vec4 edgeEnd = testInput(3);
        vec4 numbers = testInput(4);
        clothHingeBend(wing0, wing1, edgeStart, edgeEnd, numbers.x, numbers.y, numbers.z, numbers.w);
        testOutput(0, wing0);
        testOutput(1, wing1);
        testOutput(2, edgeStart);
        testOutput(3, edgeEnd);
    } else if (function == GPU_TEST_CLOTH_WRAP_ANGLE) {
        testOutput(0, vec4(clothWrapAngle(testInput(0).x)));
    } else if (function == GPU_TEST_CLOTH_SURFACE_POINT) {
        testOutput(0, clothSurfacePoint(testCollider(0u), testInput(3).xyz));
    } else if (function == GPU_TEST_CLOTH_CONTACT) {
        vec3 position = testInput(3).xyz;
        vec4 friction = testInput(5);
        clothContact(position, testInput(4).xyz, clothSurfacePoint(testCollider(0u), position), friction.x, friction.y, friction.z);
        testOutput(0, vec4(position, 0.0));
    } else if (function == GPU_TEST_CLOTH_GRAB) {
        vec4 point = testInput(0);
        clothGrab(point, testInput(1).xyz, testInput(2).x);
        testOutput(0, point);
    } else if (function == GPU_TEST_CLOTH_TETHER) {
        vec3 point = testInput(0).xyz;
        vec4 anchor = testInput(1); // its rest length and the stretch allowed in the next input
        clothTether(point, anchor.xyz, testInput(2).x, testInput(2).y);
        testOutput(0, vec4(point, 0.0));
    } else if (function == GPU_TEST_CLOTH_STITCH) {
        // The two points with their inverse masses in w, their places at the substep's start, then the closing step.
        vec4 first = testInput(0);
        vec4 second = testInput(1);
        clothStitch(first.xyz, second.xyz, first.w, second.w, testInput(2).xyz, testInput(3).xyz, testInput(4).x);
        testOutput(0, vec4(first.xyz, 0.0));
        testOutput(1, vec4(second.xyz, 0.0));
    } else if (function == GPU_TEST_CLOTH_FIELD) {
        // A point's cell in a field (its origin, spacing and sample counts), then a cell's corners blended at that share.
        ivec3 cell;
        vec3 share;
        bool inside = clothFieldCell(testInput(0).xyz, testInput(1).xyz, testInput(0).w, uvec3(testInput(2).xyz), cell, share);
        vec4 low = testInput(3);
        vec4 high = testInput(4);
        float corners[8] = float[8](low.x, low.y, low.z, low.w, high.x, high.y, high.z, high.w);
        vec4 blended = clothFieldBlend(corners, share, testInput(0).w);
        testOutput(0, vec4(inside ? 1.0 : 0.0, vec3(cell)));
        testOutput(1, vec4(share, 0.0));
        testOutput(2, blended);
        testOutput(3, clothFieldSurface(blended));
    } else if (function == GPU_TEST_CLOTH_LINE_SEARCH_TERMS) {
        // The coarse levels' pieces, cloth_gpu_test.cpp's checkLineSearchTerms.
        ClothBlock block = testBlock(0u);
        vec4 between = testInput(2);
        clothCoarseEdgeTerm(block, between.xyz, between.w);
        vec3 d0 = testInput(3).xyz;
        vec3 d1 = testInput(4).xyz;
        vec3 d2 = testInput(5).xyz;
        vec3 d3 = testInput(6).xyz;
        vec4 edge = testInput(7);
        vec4 numbers = testInput(8);
        ClothHinge hinge;
        hinge.angle = 0.0;
        for (uint corner = 0u; corner < 4u; ++corner) {
            hinge.gradient[corner] = testInput(10u + corner).xyz;
        }
        vec4 last = testInput(14);
        testOutput(0, vec4(block.diagonal, 0.0));
        testOutput(1, vec4(block.offDiagonal, 0.0));
        testOutput(2, vec4(clothInertiaCurvature(d0, numbers.y, numbers.x), clothEdgeCurvature(edge.xyz, d1 - d2, edge.w, numbers.z),
                           clothIsometricHingeCurvature(testInput(9), d0, d1, d2, d3, last.x), clothHingeAngleCurvature(hinge, d0, d1, d2, d3, last.x)));
        testOutput(3, vec4(clothHandCurvature(d3, last.y), clothLineSearchStep(last.z, last.w), 0.0, 0.0));
    } else if (function == GPU_TEST_CLOTH_BLOCK_SOLVE) {
        testOutput(0, vec4(clothBlockSolve(testBlock(0u), testInput(2).xyz), 0.0));
    } else if (function == GPU_TEST_CLOTH_FINISH_VELOCITY) {
        testOutput(0, vec4(clothFinishVelocity(testInput(0), testInput(1).xyz, testInput(2).x, testInput(2).y), 0.0));
    } else if (function == GPU_TEST_DEFORM_BLEND) {
        testOutput(0, vec4(deformBlend(testInput(0).xyz, testInput(1).xyz, testInput(2).x), 0.0));
    } else if (function == GPU_TEST_DEFORM_AREA_NORMAL) {
        testOutput(0, vec4(deformAreaNormal(testInput(0).xyz, testInput(1).xyz, testInput(2).xyz), 0.0));
    } else if (function == GPU_TEST_DEFORM_TANGENT) {
        vec4 uvs = testInput(3);
        testOutput(0, deformTangent(testInput(0).xyz, testInput(1).xyz, testInput(2).xyz, uvs.xy, uvs.zw, testInput(4).xy));
    } else if (function == GPU_TEST_DEFORM_NORMAL) {
        testOutput(0, vec4(deformNormal(testInput(0).xyz), 0.0));
    } else if (function == GPU_TEST_DEFORM_TANGENT_DIRECTION) {
        testOutput(0, vec4(deformTangentDirection(testInput(0).xyz, testInput(1).xyz), 0.0));
    }
}
