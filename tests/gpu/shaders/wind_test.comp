#version 450
#extension GL_GOOGLE_include_directive : require

// Runs wind.glsl's functions on the cases wind_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "wind.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    vec4 a = testInput(0);

    if (function == GPU_TEST_WIND_NOISE) {
        testOutput(0, vec4(windNoise(a.xyz)));
    } else if (function == GPU_TEST_WIND_VELOCITY) {
        vec4 gusts = testInput(1);
        vec4 place = testInput(2);
        testOutput(0, vec4(windVelocity(a.xy, a.z, gusts, place.xy, place.z), 0.0, 0.0));
    } else if (function == GPU_TEST_WIND_SPRING) {
        vec4 spring = testInput(1);
        testOutput(0, windSpringStep(a, spring.xy, spring.z, spring.w, testInput(2).x));
    } else if (function == GPU_TEST_WIND_CELL) {
        testOutput(0, vec4(vec2(windCellOfTexel(ivec2(a.xy), ivec2(a.zw))), 0.0, 0.0));
    } else if (function == GPU_TEST_WIND_SOFT_LEAN) {
        testOutput(0, vec4(windSoftLean(a.xy), 0.0, 0.0));
    } else if (function == GPU_TEST_WIND_FADED_LEAN) {
        testOutput(0, vec4(windFadedLean(a.xy, a.z, a.w), 0.0, 0.0));
    } else if (function == GPU_TEST_WIND_WINDOW_SHARE) {
        testOutput(0, vec4(windWindowShare(a.xy, ivec2(a.zw), testInput(1).x)));
    } else if (function == GPU_TEST_WIND_SWAY) {
        vec4 place = testInput(1);
        vec4 sway = testInput(2);
        vec4 spring = testInput(3);
        testOutput(0, vec4(windSwayOffset(a.xyz, a.w, place.xyz, sway, place.w, spring.xy, spring.z, testInput(4).xy, spring.w), 0.0));
    } else if (function == GPU_TEST_WIND_ANCHOR) {
        WindAnchorRecord anchor = WindAnchorRecord(a, testInput(1), testInput(2));
        vec4 spring = testInput(3);
        testOutput(0, vec4(windAnchorOffset(anchor, spring.xy, spring.z, spring.w), 0.0));
    } else if (function == GPU_TEST_WIND_SWING) {
        vec4 swing = testInput(1);
        vec4 spring = testInput(2);
        testOutput(0, vec4(windSwingOffset(a.w, a.xyz, swing.x, swing.y, spring.xy, spring.z, testInput(3).xy, spring.w), 0.0));
    } else if (function == GPU_TEST_WIND_HANGING) {
        vec4 second = testInput(1);
        testOutput(0, vec4(windHangingOffset(a.xyz, second.xyz, a.w, testInput(2).xyz), 0.0));
    } else if (function == GPU_TEST_WIND_FLUTTER) {
        vec4 rate = testInput(1);
        testOutput(0, vec4(windFlutterOffset(a.xyz, a.w, rate.xy, rate.z), 0.0));
    } else if (function == GPU_TEST_WIND_CHAIN) {
        testOutput(0, vec4(windChainShares(a.x, a.yzw), windChainHertz(a.x)));
    }
}