#version 450
#extension GL_GOOGLE_include_directive : require

// Runs wind.glsl's functions on the cases wind_gpu_test.cpp sends.
#include "gpu_test.glsl"
#include "wind.glsl"

void main() {
    if (outsideTheCases()) {
        return;
    }

    vec4 a = testInput(0);

    if (function == GPU_TEST_WIND_NOISE) {
        testOutput(0, vec4(windNoise(a.xyz)));
    } else if (function == GPU_TEST_WIND_VELOCITY) {
        vec4 gusts = testInput(1);
        vec4 place = testInput(2);
        testOutput(0, vec4(windVelocity(a.xy, a.z, gusts, place.xy, place.z), 0.0, 0.0));
    } else if (function == GPU_TEST_WIND_SPRING) {
        vec4 spring = testInput(1);
        testOutput(0, windSpringStep(a, spring.xy, spring.z, spring.w, testInput(2).x));
    } else if (function == GPU_TEST_WIND_CELL) {
        testOutput(0, vec4(vec2(windCellOfTexel(ivec2(a.xy), ivec2(a.zw))), 0.0, 0.0));
    }
}