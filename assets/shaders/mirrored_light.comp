#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require

/*
* Mirrored lights (render/gpu/mirrored_light.h), on GPUs with ray queries, one invocation per render pixel, between the
* depth prepass and the main pass. The shared search (mirrored_light_search.glsl) finds, for each pair of a fast light
* and a shiny surface the CPU chose, the light reflected onto this pixel's surface: the point of reflection (or a rough
* mirror's footprint round it), rays proving the way there clear and the light reaching it. The pixel keeps the sum of
* the light arriving and its brightness-weighted direction, which the main pass shades as one more light (exact for one
* pair, a blend of directions for more).
*/

// The scene's sets (0: textures, 1: the frame), the ray tracing set (2); this pass's own set is 3.
#include "ray_scene.glsl"
#include "materials.glsl"
#include "instances.glsl"
#include "frame_data.glsl"
#include "scene_lights.glsl"
#include "screen_reflections.glsl"
#include "mirrored_light_search.glsl"

layout(local_size_x = MIRROR_GROUP_SIDE, local_size_y = MIRROR_GROUP_SIDE) in;

// Must match GpuMirroredLightPass.
layout(std430, set = 3, binding = 0) readonly buffer Pass {
    mat4 inverseViewProjection; // camera-relative, as the frame was drawn (jitter included)
    vec4 size;                  // xy: the render size in pixels, zw: their inverses
} pass;

layout(set = 3, binding = 1) uniform sampler2D depth;                            // exact texels
layout(set = 3, binding = 2, rgba16f) uniform writeonly image2D mirroredLight;   // rgb: the light arriving
layout(set = 3, binding = 3, rg16f) uniform writeonly image2D mirroredDirection; // the way it arrives, folded onto a square

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);

    if (texel.x >= int(pass.size.x) || texel.y >= int(pass.size.y)) {
        return;
    }

    float pixelDepth = texelFetch(depth, texel, 0).r;
    MirroredLight light = MirroredLight(vec3(0.0), vec3(0.0));

    if (pixelDepth != GPU_FAR_DEPTH) {
        vec3 receiver = positionAtPixel(pass.inverseViewProjection, vec2(texel) + 0.5, pixelDepth, pass.size.xy);
        float cameraDistance = length(receiver);
        float lift = float(MIRROR_RAY_OFFSET) + float(MIRROR_RAY_OFFSET_PER_METRE) * cameraDistance;
        // Towards the camera, which sees this point, so off its surface on the side the light can come from.
        vec3 start = receiver - receiver * (lift / max(cameraDistance, 1e-6));
        light = mirroredLightAt(receiver, start, vec2(texel), MIRROR_FOOTPRINT_SAMPLES);
    }

    imageStore(mirroredLight, texel, vec4(light.total, 0.0));
    imageStore(mirroredDirection, texel, vec4(octahedralEncode(mirroredLightDirection(light)), 0.0, 0.0));
}
