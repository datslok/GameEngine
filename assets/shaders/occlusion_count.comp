#version 450
#extension GL_GOOGLE_include_directive : require

/*
* Occlusion culling's first stage (render/gpu/occlusion_culling.h): counts how many of the camera's draws, and their
* triangles, the farthest-depth pyramid of this frame's prepass would hide. Drawing is unchanged. One workgroup per
* batch at a time, its instances shared out among the invocations; each sums in shared memory, then adds once.
*/
#include "render/gpu/depth_shared.h"
#include "instances.glsl"
#include "screen_reflections.glsl"
#include "occlusion_culling.glsl"

layout(local_size_x = OCCLUSION_GROUP_SIZE) in;

// Must match GpuOcclusionBatch.
struct Batch {
    uint firstEntry; // its first entry in the draw list
    uint count;      // its instances
    uint triangles;  // its mesh's triangles (the level drawn)
    uint unused;
};

layout(std430, set = 2, binding = 0) readonly buffer Batches {
    Batch batches[];
};

// Must match GpuOcclusionCounts; cleared before the pass.
layout(std430, set = 2, binding = 1) buffer Counts {
    uint tested;
    uint hidden;
    uint testedTriangles;
    uint hiddenTriangles;
} counts;

layout(set = 2, binding = 2) uniform sampler2D pyramid; // the farthest depth, every level, exact texels

// Must match GpuOcclusionPass.
layout(push_constant) uniform Pass {
    mat4 view;    // the camera-relative view
    vec4 lens;    // scale x, scale y, near plane, depth constant
    vec4 origin;  // xyz: the camera in the world, w: depth per inverse distance
    ivec4 sizes;  // the screen's width and height, the pyramid's levels, the batches
} pass;

shared uint groupTested;
shared uint groupHidden;

// Whether the pyramid hides the instance: its sphere's rectangle read at the level where it covers at most 2 x 2 texels.
bool hiddenInstance(uint instance) {
    vec4 sphere = instances[instance].levelSphere;

    if (sphere.w < 0.0) {
        return false;
    }

    vec3 viewCentre = (pass.view * vec4(sphere.xyz - pass.origin.xyz, 1.0)).xyz;
    ivec4 rect;

    if (!occlusionSphereRect(viewCentre, sphere.w, pass.lens.xy, pass.lens.z, pass.sizes.xy, rect) || rect.x > rect.z || rect.y > rect.w) {
        return false;
    }

    int level = occlusionLevel(rect, pass.sizes.z);
    ivec2 levelSize = textureSize(pyramid, level);
    float farthest = float(GPU_NEAR_DEPTH);

    for (int y = pyramidCell(rect.y, level, levelSize.y); y <= pyramidCell(rect.w, level, levelSize.y); ++y) {
        for (int x = pyramidCell(rect.x, level, levelSize.x); x <= pyramidCell(rect.z, level, levelSize.x); ++x) {
            farthest = fartherDepth(farthest, texelFetch(pyramid, ivec2(x, y), level).r);
        }
    }

    return occlusionNearestDepth(viewCentre.z, sphere.w, pass.lens.w, pass.origin.w) < farthest;
}

void main() {
    // The batch loop's bounds are the same for the whole workgroup, so its barriers are reached by every invocation.
    for (uint batchIndex = gl_WorkGroupID.x; batchIndex < uint(pass.sizes.w); batchIndex += gl_NumWorkGroups.x) {
        if (gl_LocalInvocationIndex == 0) {
            groupTested = 0;
            groupHidden = 0;
        }

        barrier();

        Batch batch = batches[batchIndex];
        uint testedHere = 0;
        uint hiddenHere = 0;

        for (uint i = gl_LocalInvocationIndex; i < batch.count; i += OCCLUSION_GROUP_SIZE) {
            ++testedHere;

            if (hiddenInstance(drawnInstance(drawList[batch.firstEntry + i]))) {
                ++hiddenHere;
            }
        }

        atomicAdd(groupTested, testedHere);
        atomicAdd(groupHidden, hiddenHere);
        barrier();

        if (gl_LocalInvocationIndex == 0) {
            atomicAdd(counts.tested, groupTested);
            atomicAdd(counts.hidden, groupHidden);
            atomicAdd(counts.testedTriangles, groupTested * batch.triangles);
            atomicAdd(counts.hiddenTriangles, groupHidden * batch.triangles);
        }

        barrier();
    }
}
