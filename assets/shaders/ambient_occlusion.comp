#version 460
#extension GL_GOOGLE_include_directive : require

/*
* Ambient occlusion (render/gpu/ambient_occlusion.h), one invocation per render pixel, between the depth prepass and the
* main pass: the loop ambientOcclusionAt mirrors. The pixel's point and normal from the depths (the normal from the
* neighbours that carry on in line), then slices round the way to the camera, each walked both ways through the depth
* image marking the sectors its samples block, gathering last frame's picture for each sector newly marked, and the open
* share and the gathered light averaged; while gathering, also the mean of the picture over the first slice's samples (the
* fill, how bright the surroundings are, into a second image for the sky visibility's blocked share). Its noise turns
* with the frame for temporal anti-aliasing to average (still without it, for the blur).
*/
#include "screen_reflections.glsl"
#include "ambient_occlusion.glsl"
#include "dither.glsl"

layout(local_size_x = AO_GROUP_SIDE, local_size_y = AO_GROUP_SIDE) in;

// Must match GpuAmbientOcclusionPass.
layout(std430, set = 0, binding = 0) readonly buffer Pass {
    mat4 inverseViewProjection; // camera-relative, as the frame was drawn (jitter included)
    vec4 size;                  // xy: the render size in pixels, zw: their inverses
    vec4 lens;                  // x: a pixel's footprint per metre of view distance
    vec4 options;               // x: radius, y: falloff, z: slices, w: steps
    ivec4 frame;                // x: the frame, turning the noise
    mat4 reprojection;          // this frame's clip space (without the jitter) to last frame's
    vec4 gather;                // x: thickness, y: 1 while gathering, z: the brightest sample
} pass;

layout(set = 0, binding = 1) uniform sampler2D depth;                      // exact texels
layout(set = 0, binding = 2) uniform sampler2D picture;                    // last frame's finished picture
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D occlusion; // rgb: the light gathered, a: the visibility, 0 buried to 1 open
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D fill;      // rgb: the mean of the picture round the point, a: its view distance (0 for the sky), for the fill's blur

// The point at a texel clamped onto the screen (measured from the camera); the sky counts as the fallback point.
vec3 pointAt(ivec2 texel, vec3 fallback) {
    ivec2 clamped = clamp(texel, ivec2(0), ivec2(pass.size.xy) - 1);
    float texelDepth = texelFetch(depth, clamped, 0).r;
    return texelDepth == float(GPU_FAR_DEPTH) ? fallback : positionAtPixel(pass.inverseViewProjection, vec2(clamped) + 0.5, texelDepth, pass.size.xy);
}

// Last frame's picture where it showed the point at this texel (a 1), or nothing where it was off screen (a 0).
vec4 pictureAt(ivec2 texel, float texelDepth) {
    vec2 unjittered = vec2(texel) + 0.5 - pass.lens.yz;
    vec3 previous = reprojectPixel(pass.reprojection, unjittered, texelDepth, pass.size.xy);

    if (previous.z < 0.5 || any(lessThan(previous.xy, vec2(0.0))) || any(greaterThan(previous.xy, pass.size.xy))) {
        return vec4(0.0);
    }

    return vec4(gatheredSampleLight(textureLod(picture, previous.xy * pass.size.zw, 0.0).rgb, pass.gather.z), 1.0);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(pass.size.xy);

    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    float pixelDepth = texelFetch(depth, texel, 0).r;
    vec2 pixel = vec2(texel) + 0.5;
    float radius = pass.options.x;
    float viewDistance = pixelDepth == float(GPU_FAR_DEPTH) ? 0.0 : viewDistanceAtPixel(pass.inverseViewProjection, pixel, pixelDepth, pass.size.xy);
    float screenRadius = pixelDepth == float(GPU_FAR_DEPTH) ? 0.0 : aoScreenRadius(radius, pass.lens.x, viewDistance);

    if (screenRadius < float(AO_MIN_SAMPLE_PIXELS)) {
        imageStore(occlusion, texel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(fill, texel, vec4(0.0, 0.0, 0.0, viewDistance));
        return;
    }

    vec3 position = positionAtPixel(pass.inverseViewProjection, pixel, pixelDepth, pass.size.xy);
    vec3 across = surfaceStep(position, pointAt(texel + ivec2(-1, 0), position), pointAt(texel + ivec2(-2, 0), position),
                              pointAt(texel + ivec2(1, 0), position), pointAt(texel + ivec2(2, 0), position));
    vec3 downwards = surfaceStep(position, pointAt(texel + ivec2(0, -1), position), pointAt(texel + ivec2(0, -2), position),
                                 pointAt(texel + ivec2(0, 1), position), pointAt(texel + ivec2(0, 2), position));
    vec3 normal = depthNormal(position, across, downwards);
    vec3 toCamera = normalize(-position);

    vec2 framePixel = pixel + 5.588238 * float(pass.frame.x);
    float sliceNoise = interleavedGradientNoise(framePixel);
    float stepNoise = interleavedGradientNoise(framePixel + vec2(23.0, 41.0));
    int slices = int(pass.options.z);
    int steps = int(pass.options.w);
    float thickness = pass.gather.x;
    bool gathers = pass.gather.y > 0.5;
    float visibility = 0.0;
    vec3 gathered = vec3(0.0);
    vec4 surroundings = vec4(0.0); // the picture summed over every sample seen last frame and their weights, each
                                   // fading to nothing at the reach, so a bright patch leaving it fades rather than steps

    for (int slice = 0; slice < slices; ++slice) {
        float angle = 3.14159265 * (float(slice) + sliceNoise) / float(slices);
        vec2 onScreen = vec2(cos(angle), sin(angle));
        vec3 direction = positionAtPixel(pass.inverseViewProjection, pixel + onScreen, pixelDepth, pass.size.xy) - position;
        AoSlice plane = aoSlice(normal, toCamera, direction);
        float lows[2] = float[2](lowHorizonCosine(plane, 0), lowHorizonCosine(plane, 1));
        uint marked = 0u;
        vec3 sliceLight = vec3(0.0);

        // Each side remembers its last sample while the surface runs on, to fill the gap to the next.
        bool runsOn[2] = bool[2](false, false);
        float lastShare[2] = float[2](0.0, 0.0);
        float lastDepth[2] = float[2](0.0, 0.0);

        for (int index = 0; index < steps; ++index) {
            float distance = aoSampleDistance(index, steps, stepNoise, screenRadius);

            for (int side = 0; side < 2; ++side) {
                ivec2 at = ivec2(floor(pixel + onScreen * (side == 0 ? distance : -distance)));

                if (any(lessThan(at, ivec2(0))) || any(greaterThanEqual(at, size))) {
                    runsOn[side] = false;
                    continue;
                }

                float atDepth = texelFetch(depth, at, 0).r;

                if (atDepth == float(GPU_FAR_DEPTH)) {
                    runsOn[side] = false;
                    continue;
                }

                vec3 offset = positionAtPixel(pass.inverseViewProjection, vec2(at) + 0.5, atDepth, pass.size.xy) - position;
                float weight = occluderWeight(length(offset), radius, pass.options.y);

                if (weight <= 0.0) {
                    runsOn[side] = false;
                    continue;
                }

                float low = lows[side];
                float front = sectorShare(plane, low + (horizonCosine(offset, toCamera) - low) * weight, side);
                float back = sectorShare(plane, low + (horizonCosine(offset - toCamera * thickness, toCamera) - low) * weight, side);
                float behind = -dot(offset, toCamera);
                float start = min(front, back);
                float end = max(front, back);

                if (runsOn[side] && abs(behind - lastDepth[side]) < thickness) {
                    start = min(start, lastShare[side]);
                    end = max(end, lastShare[side]);
                }

                runsOn[side] = true;
                lastShare[side] = front;
                lastDepth[side] = behind;
                uint mask = sectorMask(start, end);
                uint fresh = mask & ~marked;

                // The fill takes the first slice's samples alone: its blur smooths it anyway, and each read costs a reprojection.
                if (gathers && (fresh != 0u || slice == 0)) {
                    vec4 seen = pictureAt(at, atDepth);

                    // Only what lies above the surface lights it (fillFacingWeight).
                    if (slice == 0) {
                        surroundings += seen * (weight * fillFacingWeight(normal, offset));
                    }

                    if (fresh != 0u) {
                        sliceLight += seen.rgb * (float(bitCount(fresh)) / float(AO_SECTORS));
                    }
                }

                marked |= mask;
            }
        }

        float sliceWeight = sliceVisibility(plane, lows[0], lows[1]);
        visibility += sliceWeight * (1.0 - float(bitCount(marked)) / float(AO_SECTORS));
        gathered += sliceLight * sliceWeight;
    }

    imageStore(occlusion, texel, vec4(gathered / float(slices), clamp(visibility / float(slices), 0.0, 1.0)));
    imageStore(fill, texel, vec4(surroundings.a > 1e-6 ? surroundings.rgb / surroundings.a : vec3(0.0), viewDistance));
}
