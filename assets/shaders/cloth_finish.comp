#version 450
#extension GL_GOOGLE_include_directive : require

/*
* A substep's end for every point, in the CPU solver's order: XPBD's hand on its point (vertex block descent's is in
* each point's step), then the tethers to its nearest pins (clothHandAndTethers; for a point in a stitch, the stitch
* pass before this one has done both and then its stitch), then the bodies (each free point pushed out of every body
* in turn, with friction, the shapes and then the field bodies; without friction while its stitch is still being sewn,
* as markSewing says, read from the points' previous positions, which nothing here writes), then the velocity from the
* motion, slowed by the air.
* Each step touches only its own point, so one invocation per point does them all. A tether reads its anchor, a pinned
* point, which nothing here moves; so a pinned point's position is not written back (it is unchanged), and no
* invocation writes what another reads.
*/
#include "cloth_pass.glsl"

void main() {
    uint point;
    if (!clothItem(point)) {
        return;
    }

    ClothTick tick = ticks[tickIndex];
    vec4 position = positions[point];
    vec3 previous = previousPositions[point].xyz;

    uint partner = stitchPartners[point];
    if (partner == CLOTH_NO_STITCH) {
        clothHandAndTethers(point, position, tick);
    }

    bool touched = false;
    if (position.w != 0.0) {
        bool beingSewn = partner != CLOTH_NO_STITCH && clothStitchWidest(previous, previousPositions[partner].xyz, tick.stitchClosingStep) > 0.0;
        float staticFriction = beingSewn ? 0.0 : tick.staticFriction;
        float kineticFriction = beingSewn ? 0.0 : tick.kineticFriction;
        for (uint body = 0u; body < tick.colliderCount; ++body) {
            ClothCollider collider = colliders[tick.colliderFirst + body];
            vec4 surface = clothSurfacePoint(collider, position.xyz);
            touched = touched || tick.thickness - surface.w > 0.0;
            clothContact(position.xyz, previous, surface, tick.thickness, staticFriction, kineticFriction);
        }
        for (uint body = 0u; body < tick.fieldCount; ++body) {
            vec4 surface = clothFieldSurfacePoint(fields[tick.fieldFirst + body], position.xyz);
            touched = touched || tick.thickness - surface.w > 0.0;
            clothContact(position.xyz, previous, surface, tick.thickness, staticFriction, kineticFriction);
        }

        positions[point] = position;
    }

    // With self-collision, its passes come next and the velocity after them (cloth_self_end.comp); meanwhile w says
    // whether a body held the point up, which the contacts read.
    if (tick.selfCollision != 0u) {
        velocities[point].w = touched ? 1.0 : 0.0;
        return;
    }
    velocities[point] = vec4(clothFinishVelocity(position, previous, tick.substepSeconds, tick.kept), 0.0);
}
