#version 450
#extension GL_GOOGLE_include_directive : require

/*
* Reflections (render/gpu/screen_reflections.h), one invocation per render pixel, in place on the scene image. Each
* glossy pixel swaps the stand-in the main pass added for better light, in two steps, each as far as it is trusted:
* 1. The reflection probe round the camera (render/gpu/reflection_probe.h): the mirror ray's meeting with what the probe
*    saw, found by the parallax search (the loop searchProbe mirrors), read from the prefiltered level for the pixel's
*    roughness.
* 2. Screen-space reflections: the mirror ray followed through the depth pyramid (the loop traceScreenRay mirrors);
*    where it hits, the hit's surface in last frame's picture (by its motion if it moved, else through the two cameras),
*    read from the colour pyramid's level as wide as the reflected cone.
* Where neither is trusted at all, the pixel is left exactly as the main pass drew it.
*/
#include "screen_reflections.glsl"
#include "reflection_probe.glsl"

// octahedralDecode, for the normals the main pass folded onto a square.
#include "ddgi.glsl"

layout(local_size_x = SSR_GROUP_SIDE, local_size_y = SSR_GROUP_SIDE) in;

// Must match GpuReflectionPass.
layout(std430, set = 0, binding = 0) readonly buffer Pass {
    mat4 viewProjection;        // camera-relative, as the frame was drawn (jitter included)
    mat4 inverseViewProjection;
    mat4 reprojection;          // this frame's clip space (without the jitter) to last frame's
    vec4 size;                  // xy: the render size in pixels, zw: their inverses
    vec4 options;               // x: sharp roughness, y: max roughness, z: thickness, w: reach
    vec4 limits;                // x: max steps, y: the pyramid's top level, z: edge fade, w: 1 to show the confidence
    vec4 lens;                  // x: pixel footprint per metre, yz: this frame's jitter in render pixels
    vec4 probe;                 // x: 1 when the probe is read, y: its prefiltered levels, z: 1 when screen-space reflections run, w: its far plane
    vec4 probeOrigin;           // xyz: where the probe was taken, measured from the camera
} pass;

layout(set = 0, binding = 1) uniform sampler2D depthPyramid;      // exact texels, every level
layout(set = 0, binding = 2) uniform sampler2D colourPyramid;     // trilinear, clamped
layout(set = 0, binding = 3) uniform sampler2D surfaceNormal;     // the main pass's reflection surfaces, exact texels
layout(set = 0, binding = 4) uniform sampler2D surfaceProperties;
layout(set = 0, binding = 5) uniform sampler2D surfaceStandIn;
layout(set = 0, binding = 6) uniform sampler2D velocity;          // moving objects' motion, or TAA_NO_MOTION
layout(set = 0, binding = 7) uniform samplerCube probeLight;      // the probe's prefiltered light, trilinear, every level
layout(set = 0, binding = 8) uniform samplerCube probeDistance;   // how far the probe saw, nearest texel
layout(set = 0, binding = 9, rgba16f) uniform image2D scene;

// What one source of reflection found: how far it is trusted, and the light it reflects.
struct Reflection {
    float confidence;
    vec3 light;
};

// The glossy pixel a reflection leaves from: its position and normal, the mirror direction, and how rough it is.
struct Glossy {
    vec2 pixel;
    vec3 position;
    vec3 normal;
    vec3 direction;
    float depth;
    float roughness;
};

// The march through the pyramid, as traceScreenRay: out of the start texel, then hizStep until a hit within the
// thickness, the ray's end or the step limit. Returns whether it hit, and where in found.
bool march(ScreenRay ray, out HizTrace found) {
    vec2 size = pass.size.xy;
    int topLevel = int(pass.limits.y);
    int maxSteps = int(pass.limits.x);
    HizTrace trace = passTexel(HizTrace(ray.start, 0.0, 0), ray);
    found = trace;

    for (int step = 0; step < maxSteps && trace.t <= ray.end; ++step) {
        ivec2 levelSize = textureSize(depthPyramid, trace.level);
        ivec2 cell = ivec2(pyramidCell(int(floor(trace.position.x)), trace.level, levelSize.x),
                           pyramidCell(int(floor(trace.position.y)), trace.level, levelSize.y));
        float nearest = texelFetch(depthPyramid, cell, trace.level).r;
        HizTrace next = hizStep(trace, ray, nearest, topLevel);

        if (next.level >= 0) {
            trace = next;
            continue;
        }

        if (next.t > ray.end) {
            return false;
        }

        if (withinThickness(viewDistanceAtPixel(pass.inverseViewProjection, next.position.xy, next.position.z, size),
                            viewDistanceAtPixel(pass.inverseViewProjection, next.position.xy, nearest, size), pass.options.z)) {
            found = next;
            return true;
        }

        trace = passTexel(next, ray);
    }

    return false;
}

// The distance the probe saw towards the ray's point at t.
float probeDistanceAt(vec3 position, vec3 direction, float t) {
    return textureLod(probeDistance, parallaxDirection(position, direction, t), 0.0).r;
}

// The probe's reflection: the parallax search, as searchProbe, from the pixel measured from where the probe was taken:
// the march to the first step where the ray goes behind what the probe saw, after being in front of it, then halving.
Reflection reflectFromProbe(Glossy glossy) {
    vec3 position = glossy.position - pass.probeOrigin.xyz;
    vec3 direction = glossy.direction;
    float ratio = probeMarchRatio(pass.probe.w + length(position));
    float t = float(PROBE_MARCH_START);
    bool beenInFront = false;
    float frontT = 0.0;
    float frontDistance = 0.0;
    float behindT = -1.0;
    float behindDistance = 0.0;

    for (int step = 0; step <= PROBE_MARCH_STEPS; ++step, t *= ratio) {
        float stored = probeDistanceAt(position, direction, t);

        if (parallaxMismatch(position, direction, t, stored) < 0.0) {
            beenInFront = true;
            frontT = t;
            frontDistance = stored;
        } else if (beenInFront) {
            behindT = t;
            behindDistance = stored;
            break;
        }
    }

    if (behindT < 0.0) {
        return Reflection(0.0, vec3(0.0));
    }

    for (int halving = 0; halving < PROBE_REFINE_STEPS; ++halving) {
        float middle = 0.5 * (frontT + behindT);
        float stored = probeDistanceAt(position, direction, middle);

        if (parallaxMismatch(position, direction, middle, stored) < 0.0) {
            frontT = middle;
            frontDistance = stored;
        } else {
            behindT = middle;
            behindDistance = stored;
        }
    }

    vec3 found = parallaxDirection(position, direction, behindT);
    float trust = parallaxConfidence(frontDistance, behindDistance);
    float rough = 1.0 - smoothstep(pass.options.x, pass.options.y, glossy.roughness);
    return Reflection(trust * rough, textureLod(probeLight, found, probeRoughnessLevel(glossy.roughness, pass.probe.y)).rgb);
}

// Screen-space reflection: none where the march misses or the hit was off last frame's picture.
Reflection reflectFromScreen(Glossy glossy) {
    Reflection none = Reflection(0.0, vec3(0.0));
    vec2 size = pass.size.xy;

    // Off the surface by a few pixels' footprint, so the surface it leaves does not hide it.
    float distance = viewDistanceAtPixel(pass.inverseViewProjection, glossy.pixel, glossy.depth, size);
    vec3 start = glossy.position + glossy.normal * (float(SSR_START_OFFSET_PIXELS) * pass.lens.x * distance);
    ScreenRay ray = screenRay(pass.viewProjection, start, glossy.direction, pass.options.w, size);
    HizTrace found;

    if (!march(ray, found)) {
        return none;
    }

    ivec2 hitTexel = clamp(ivec2(floor(found.position.xy)), ivec2(0), ivec2(size) - 1);
    vec2 hitPixel = vec2(hitTexel) + 0.5;
    float hitDepth = texelFetch(depthPyramid, hitTexel, 0).r;
    vec3 hitPosition = positionAtPixel(pass.inverseViewProjection, hitPixel, hitDepth, size);
    vec3 hitNormal = octahedralDecode(texelFetch(surfaceNormal, hitTexel, 0).xy);
    float confidence = reflectionConfidence(glossy.roughness, hitPixel, length(hitPosition - glossy.position), dot(hitNormal, glossy.direction),
                                            size, pass.options.x, pass.options.y, pass.limits.z, pass.options.w);

    // Where the hit's surface was in last frame's picture, from its centre without this frame's jitter: by its motion if
    // it moved, else through the two cameras; nothing to reflect where it was off that picture or behind its camera.
    vec2 unjittered = hitPixel - pass.lens.yz;
    vec2 motion = texelFetch(velocity, hitTexel, 0).xy;
    vec3 previous = motion.x > TAA_NO_MOTION_TEST ? reprojectPixel(pass.reprojection, unjittered, hitDepth, size)
                                                   : vec3(previousPixelFromMotion(unjittered, motion, size), 1.0);

    if (previous.z < 0.5 || any(lessThan(previous.xy, vec2(0.0))) || any(greaterThan(previous.xy, size))) {
        return none;
    }

    float level = reflectionConeLevel(glossy.roughness, length(found.position.xy - ray.start.xy));
    return Reflection(confidence, textureLod(colourPyramid, previous.xy * pass.size.zw, level).rgb);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);

    if (texel.x >= int(pass.size.x) || texel.y >= int(pass.size.y)) {
        return;
    }

    vec4 surface = texelFetch(surfaceProperties, texel, 0);
    Glossy glossy;
    glossy.pixel = vec2(texel) + 0.5;
    glossy.depth = texelFetch(depthPyramid, texel, 0).r;
    glossy.roughness = surface.a;
    glossy.position = positionAtPixel(pass.inverseViewProjection, glossy.pixel, glossy.depth, pass.size.xy);
    glossy.normal = octahedralDecode(texelFetch(surfaceNormal, texel, 0).xy);
    glossy.direction = reflect(normalize(glossy.position), glossy.normal);

    // None for the sky, surfaces too rough, and mirror rays into the surface (normal maps can tilt them there).
    bool glossyEnough = glossy.depth > float(GPU_FAR_DEPTH) && glossy.roughness < pass.options.y && dot(glossy.direction, glossy.normal) > 0.0;
    Reflection probed = Reflection(0.0, vec3(0.0));
    Reflection screen = Reflection(0.0, vec3(0.0));

    if (glossyEnough && pass.probe.x > 0.5) {
        probed = reflectFromProbe(glossy);
    }

    if (glossyEnough && pass.probe.z > 0.5) {
        screen = reflectFromScreen(glossy);
    }

    // The debug view: white where screen-space reflections are trusted, blue where the probe is, black for the stand-in.
    if (pass.limits.w > 0.5) {
        imageStore(scene, texel, vec4(mix(vec3(0.0, 0.0, probed.confidence), vec3(1.0), screen.confidence), 1.0));
        return;
    }

    // Untouched where neither is trusted at all, so the picture is exactly the main pass's there.
    if (!(probed.confidence > 0.0) && !(screen.confidence > 0.0)) {
        return;
    }

    vec4 colour = imageLoad(scene, texel);
    vec3 standIn = texelFetch(surfaceStandIn, texel, 0).rgb;
    vec3 withProbe = reflectedScene(colour.rgb, standIn, surface.rgb, probed.light, probed.confidence);
    vec3 probeStandIn = blendedStandIn(standIn, surface.rgb, probed.light, probed.confidence);
    imageStore(scene, texel, vec4(reflectedScene(withProbe, probeStandIn, surface.rgb, screen.light, screen.confidence), colour.a));
}
