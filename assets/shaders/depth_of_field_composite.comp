#version 460
#extension GL_GOOGLE_include_directive : require

/*
* Depth of field's last pass (render/gpu/depth_of_field.h, depthOfFieldComposite), one invocation per output pixel: the
* pixel's own blur radius from the depth (at full resolution, so edges in focus stay sharp), the sharp pixel or the far
* layer by it, the near layer over either by its coverage, both layers read between their blur pixels. With showFocus
* on, the blur tinted: blue in front of the focus, orange behind.
*/
#include "screen_reflections.glsl"
#include "depth_of_field.glsl"

layout(local_size_x = DEPTH_OF_FIELD_GROUP, local_size_y = DEPTH_OF_FIELD_GROUP) in;

#include "depth_of_field_pass.glsl"

layout(set = 0, binding = 2) uniform sampler2D depth;     // render size, exact texels
layout(set = 0, binding = 3) uniform sampler2D picture;   // output size, exact texels
layout(set = 0, binding = 4) uniform sampler2D farLayer;  // blur grid, filtered
layout(set = 0, binding = 5) uniform sampler2D nearLayer; // blur grid, filtered
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D result;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(pixel, ivec2(pass.outputSize.xy)))) {
        return;
    }

    vec4 sharp = texelFetch(picture, pixel, 0);
    float radius = outputBlurRadius(depth, pixel);
    // Blur pixel b covers output pixels 2 b and 2 b + 1, so an output pixel's middle lies at half its own place.
    vec2 place = (vec2(pixel) + 0.5) * 0.5 / vec2(textureSize(farLayer, 0));
    vec3 far = textureLod(farLayer, place, 0.0).rgb;
    vec4 near = textureLod(nearLayer, place, 0.0);
    vec3 colour = depthOfFieldComposite(sharp.rgb, radius, far, near.rgb, near.a);

    if (pass.options.x > 0.5) {
        float blurred = clamp(abs(radius) / float(DEPTH_OF_FIELD_IN_FOCUS) - 1.0, 0.0, 1.0);
        vec3 tint = radius < 0.0 ? vec3(0.1, 0.35, 1.0) : vec3(1.0, 0.45, 0.1);
        float brightness = max(dot(colour, vec3(0.2126, 0.7152, 0.0722)), 0.05);
        colour = mix(colour, tint * brightness * 2.0, 0.6 * blurred);
    }

    imageStore(result, pixel, vec4(colour, sharp.a));
}
