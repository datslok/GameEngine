#version 460
#extension GL_GOOGLE_include_directive : require

// Sharing between neighbouring probes (render/gpu/ddgi.h, GlobalIlluminationSettings::probeSharing): each probe's
// irradiance, still and fast, read as its own light and that of each face neighbour it can see (its mean distance
// towards the neighbour reaching most of the way there), weighted by sharedProbeValue, into the shared atlases that
// everything reads. One workgroup per probe, one invocation per texel of its square, the border copied last, as in the
// update. The probes' own atlases are only read, so they keep accumulating their own light. A probe a scene event
// restarted shares its still light more for a while (eventProbeSharingWeight), from the restarts the update reads.
// Neighbours are found within the probe's own cascade, by grid place (its storage is scrolled), never across its edge.
#include "render/gpu/ddgi_shared.h"
#include "ddgi.glsl"
#include "probe_cascades.glsl"
#include "probe_relocation.glsl"

layout(local_size_x = DDGI_IRRADIANCE_TEXELS, local_size_y = DDGI_IRRADIANCE_TEXELS) in;

// Must match GpuProbeShare in render/gpu/ddgi.h.
layout(push_constant) uniform ProbeShareData {
    ivec4 counts;  // xy the atlases' columns and rows, z every cascade's probes together, w how many cascades
    vec4 weight;   // x the still light's sharing weight, y the fast light's, z a restarted probe's at first, w the long memory's share kept
} share;

// Each probe's scene event restarts (ProbeRestart).
layout(std430, set = 0, binding = 0) readonly buffer ProbeRestarts {
    ProbeRestart probeRestarts[];
};

// Each probe's offset and state (render/gpu/probe_relocation.h): only traced probes share, each with its traced
// neighbours, measured between where relocation moved them.
layout(std430, set = 0, binding = 1) readonly buffer ProbeStates {
    ProbeState probeStates[];
};

// The cascades: where each one's probes are, how many and how they are scrolled.
layout(std430, set = 0, binding = 2) readonly buffer ProbeCascades {
    ProbeCascade probeCascades[];
};

#include "probe_cascade_holding.glsl"

layout(set = 0, binding = 3, rgba16f) readonly uniform image2D irradiance;
layout(set = 0, binding = 4, rgba16f) readonly uniform image2D fastIrradiance;
layout(set = 0, binding = 5, rg16f) readonly uniform image2D distances;
layout(set = 0, binding = 6, rgba16f) writeonly uniform image2D sharedIrradiance;
layout(set = 0, binding = 7, rgba16f) writeonly uniform image2D sharedFastIrradiance;

shared vec4 square[DDGI_IRRADIANCE_TEXELS][DDGI_IRRADIANCE_TEXELS];
shared vec4 fastSquare[DDGI_IRRADIANCE_TEXELS][DDGI_IRRADIANCE_TEXELS];

void main() {
    const ivec3 steps[DDGI_SHARE_NEIGHBOURS] = ivec3[DDGI_SHARE_NEIGHBOURS](ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 1, 0),
                                                                          ivec3(0, -1, 0), ivec3(0, 0, 1), ivec3(0, 0, -1));
    int probe = int(gl_WorkGroupID.x);

    // An untraced probe is never read, so its shared copy is left as it is; the whole workgroup leaves together.
    if (!probeTraced(probeStates[probe].state)) {
        return;
    }

    ivec2 atlas = share.counts.xy;
    ProbeCascade cascade = probeCascades[probeCascadeHolding(probe, share.counts.w)];
    ivec3 counts = cascade.counts.xyz;
    ivec3 grid = probeGridCoord(counts, cascade.scroll.xyz, probe - cascade.scroll.w);
    ivec2 texel = ivec2(gl_LocalInvocationID.xy);
    ivec2 origin = probeTileOrigin(atlas, probe, DDGI_IRRADIANCE_TEXELS);
    ivec2 distanceOrigin = probeTileOrigin(atlas, probe, DDGI_DISTANCE_TEXELS);

    vec4 own = imageLoad(irradiance, origin + 1 + texel);
    vec4 ownFast = imageLoad(fastIrradiance, origin + 1 + texel);
    vec3 neighbours[DDGI_SHARE_NEIGHBOURS];
    vec3 fastNeighbours[DDGI_SHARE_NEIGHBOURS];
    bool visible[DDGI_SHARE_NEIGHBOURS];

    for (int neighbour = 0; neighbour < DDGI_SHARE_NEIGHBOURS; ++neighbour) {
        ivec3 step = steps[neighbour];
        ivec3 other = grid + step;
        neighbours[neighbour] = vec3(0.0);
        fastNeighbours[neighbour] = vec3(0.0);
        visible[neighbour] = false;

        if (any(lessThan(other, ivec3(0))) || any(greaterThanEqual(other, counts))) {
            continue;
        }

        int otherProbe = cascadeProbeNumber(cascade, other);

        if (probeTraced(probeStates[otherProbe].state)) {
            vec3 between = vec3(step) * cascade.spacing.xyz + probeStates[otherProbe].offset - probeStates[probe].offset;
            float separation = length(between);
            ivec2 towards = probeDirectionTexel(between / separation, DDGI_DISTANCE_TEXELS);
            float meanDistance = imageLoad(distances, distanceOrigin + 1 + towards).r;
            ivec2 otherOrigin = probeTileOrigin(atlas, otherProbe, DDGI_IRRADIANCE_TEXELS);
            visible[neighbour] = probesSeeEachOther(meanDistance, separation);
            neighbours[neighbour] = imageLoad(irradiance, otherOrigin + 1 + texel).rgb;
            fastNeighbours[neighbour] = imageLoad(fastIrradiance, otherOrigin + 1 + texel).rgb;
        }
    }

    float weight = eventProbeSharingWeight(share.weight.x, share.weight.z, probeRestarts[probe].frames.x, share.weight.w);
    vec4 result = vec4(sharedProbeValue(own.rgb, neighbours, visible, weight), own.a);
    vec4 fastResult = vec4(sharedProbeValue(ownFast.rgb, fastNeighbours, visible, share.weight.y), ownFast.a);
    imageStore(sharedIrradiance, origin + 1 + texel, result);
    imageStore(sharedFastIrradiance, origin + 1 + texel, fastResult);
    square[texel.y][texel.x] = result;
    fastSquare[texel.y][texel.x] = fastResult;

    barrier();

    int number = int(gl_LocalInvocationIndex);

    if (number < probeBorderTexelCount(DDGI_IRRADIANCE_TEXELS)) {
        ivec2 bordered = probeBorderTexel(number, DDGI_IRRADIANCE_TEXELS);
        ivec2 source = probeBorderSource(bordered, DDGI_IRRADIANCE_TEXELS) - 1;
        imageStore(sharedIrradiance, origin + bordered, square[source.y][source.x]);
        imageStore(sharedFastIrradiance, origin + bordered, fastSquare[source.y][source.x]);
    }
}
