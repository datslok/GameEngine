#version 450
#extension GL_GOOGLE_include_directive : require

/*
* Mesh clusters' culling, pass 4 of 4 (render/vulkan/vulkan_mesh_cluster_culling.h): each pair tested again (cheaper
* than keeping a flag a pair), and each survivor written at its block's first place plus the survivors before it in the
* block (a prefix sum), within the room, in the list's own run of the items (its number times the room); the written
* survivors' triangles and the late list's candidates added to the list's totals, once a workgroup.
* Dispatched as the test pass is. Mirrored by cullMeshClustersOnCpu.
*/
// After its 15 storage buffers.
#define MESH_CLUSTER_PYRAMID_BINDING (MESH_CLUSTER_PASS_BINDINGS + 3)
#include "mesh_cluster_pass.glsl"

layout(local_size_x = MESH_CLUSTER_GROUP_SIZE) in;

layout(std430, set = 0, binding = MESH_CLUSTER_PASS_BINDINGS) readonly buffer BlockFirst {
    uint blockFirst[];
};

// The survivors, setup.z at most.
layout(std430, set = 0, binding = MESH_CLUSTER_PASS_BINDINGS + 1) writeonly buffer Items {
    MeshClusterItem items[];
};

// MESH_CLUSTER_TOTAL_WORDS: the triangles added here.
layout(std430, set = 0, binding = MESH_CLUSTER_PASS_BINDINGS + 2) buffer Totals {
    uint totals[];
};

shared uint sums[MESH_CLUSTER_GROUP_SIZE];
shared uint triangles;
shared uint candidates;

void main() {
    uint local = gl_LocalInvocationIndex;
    uint pair = gl_GlobalInvocationID.x;
    MeshClusterItem item;
    bool candidate = false;
    bool kept = pair < work[MESH_CLUSTER_WORK_END] && meshClusterPairKept(pair, item, candidate);
    uint value = kept ? 1u : 0u;
    sums[local] = value;

    if (local == 0u) {
        triangles = 0u;
        candidates = 0u;
    }

    barrier();

    for (uint offset = 1u; offset < MESH_CLUSTER_GROUP_SIZE; offset *= 2u) {
        uint before = local >= offset ? sums[local - offset] : 0u;
        barrier();
        sums[local] += before;
        barrier();
    }

    if (kept) {
        uint place = blockFirst[gl_WorkGroupID.x] + sums[local] - value;

        if (place < setup.z) {
            items[pass.list * setup.z + place] = item;
            atomicAdd(triangles, clusters[item.cluster].counts >> MESH_CLUSTER_TRIANGLE_SHIFT);
        }
    }

    if (candidate) {
        atomicAdd(candidates, 1u);
    }

    barrier();

    if (local == 0u && triangles > 0u) {
        atomicAdd(totals[listTotals() + MESH_CLUSTER_TOTAL_TRIANGLES], triangles);
    }

    if (local == 0u && candidates > 0u) {
        atomicAdd(totals[listTotals() + MESH_CLUSTER_TOTAL_CANDIDATES], candidates);
    }
}
