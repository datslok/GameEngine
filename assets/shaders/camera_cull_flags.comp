#version 450
#extension GL_GOOGLE_include_directive : require

/*
* The GPU culling, flags pass (render/vulkan/vulkan_camera_culling.h): dispatched indirectly over the view's visible
* candidates only (those in segments whose chunk passed, in segment order; the dispatch's y the view). Each workgroup's
* candidates lie in a few consecutive visible segments: one invocation finds the first (a binary search of the visible
* segment list), the workgroup loads the next ones into shared memory (each holds at least one candidate, so a
* workgroup's worth covers its candidates), and each invocation finds its own segment there. Each then flags whether
* the view and the velocity pass draw its candidate with that slot (cameraCandidateFlags), keeping the candidate's place
* in the list in the flags' upper bits, and the workgroup sums its flags (an exclusive prefix sum in shared memory,
* Hillis and Steele's), keeping each candidate's offset within the block and the block's totals for the scan, in the
* view's slices. The draws drawn at each level are counted too.
*/
#include "camera_culling.glsl"

layout(local_size_x = CAMERA_CULL_GROUP_SIZE) in;

layout(std430, set = 0, binding = 0) readonly buffer Records {
    CullRecord records[];
};

layout(std430, set = 0, binding = 1) readonly buffer Levels {
    MeshLevels meshLevels[];
};

layout(std430, set = 0, binding = 2) readonly buffer Candidates {
    CullCandidate candidates[];
};

layout(std430, set = 0, binding = 3) readonly buffer Views {
    CameraCull views[];
};

// A visible candidate's CAMERA_CULL_* flags, its place in the candidate list above them (<< CAMERA_CULL_FLAG_BITS).
layout(std430, set = 0, binding = 4) writeonly buffer Flags {
    uint flags[];
};

// Each candidate's offset within its block: x the camera's list, y the velocity pass's.
layout(std430, set = 0, binding = 5) writeonly buffer Offsets {
    uvec2 offsets[];
};

// Each block's totals, summed in place by the scan.
layout(std430, set = 0, binding = 6) writeonly buffer BlockSums {
    uvec2 blockSums[];
};

// A GpuCameraCullCounts a view; cleared before the pass.
layout(std430, set = 0, binding = 7) buffer Counts {
    uint counts[];
};

layout(std430, set = 0, binding = 8) readonly buffer Segments {
    CullSegment segments[];
};

// x the segment, y its first place among the visible candidates; by place among the visible segments.
layout(std430, set = 0, binding = 9) readonly buffer VisibleSegments {
    uvec2 visibleSegments[];
};

layout(std430, set = 0, binding = 10) readonly buffer Work {
    CullViewWork work[];
};

shared uvec2 sums[CAMERA_CULL_GROUP_SIZE];
shared uint levelCounts[CULL_LEVEL_SLOTS];
shared uvec2 window[CAMERA_CULL_GROUP_SIZE];
shared uint windowFirst;

// The last visible segment starting at or before place: the visible list is in place order.
uint firstSegmentAt(CameraCull view, uint visible, uint place) {
    uint low = 0u;
    uint high = visible;

    while (high - low > 1u) {
        uint middle = (low + high) / 2u;

        if (visibleSegments[view.segmentSlices.x + middle].y <= place) {
            low = middle;
        } else {
            high = middle;
        }
    }

    return low;
}

void main() {
    uint local = gl_LocalInvocationIndex;
    CameraCull view = views[gl_WorkGroupID.y];
    CullViewWork viewWork = work[view.view];
    uint first = gl_WorkGroupID.x * CAMERA_CULL_GROUP_SIZE;

    // The dispatch covers the batch's most; a view with fewer leaves the rest of its workgroups idle (whole workgroups,
    // so no barrier below is skipped by part of one).
    if (first >= viewWork.visibleCandidates) {
        return;
    }

    if (local < CULL_LEVEL_SLOTS) {
        levelCounts[local] = 0u;
    }

    if (local == 0u) {
        windowFirst = firstSegmentAt(view, viewWork.visibleSegments, first);
    }

    barrier();
    uint windowCount = min(CAMERA_CULL_GROUP_SIZE, viewWork.visibleSegments - windowFirst);

    if (local < windowCount) {
        window[local] = visibleSegments[view.segmentSlices.x + windowFirst + local];
    }

    barrier();

    uint place = first + local;
    uint slice = view.slices.x + place;
    uint candidateFlags = 0u;

    if (place < viewWork.visibleCandidates) {
        uint low = 0u;
        uint high = windowCount;

        while (high - low > 1u) {
            uint middle = (low + high) / 2u;

            if (window[middle].y <= place) {
                low = middle;
            } else {
                high = middle;
            }
        }

        uint candidateIndex = segments[window[low].x].firstCandidate + (place - window[low].y);
        CullCandidate candidate = candidates[candidateIndex];
        CullRecord record = records[candidate.draw];
        candidateFlags = cameraCandidateFlags(record, meshLevels[record.mesh], view, candidate.slot);
        flags[slice] = candidateFlags | (candidateIndex << CAMERA_CULL_FLAG_BITS);

        if ((candidateFlags & CAMERA_CULL_DRAWN) != 0u) {
            atomicAdd(levelCounts[candidate.slot], 1u);
        }
    }

    uvec2 value = uvec2((candidateFlags & CAMERA_CULL_DRAWN) != 0u ? 1u : 0u, (candidateFlags & CAMERA_CULL_MOVING) != 0u ? 1u : 0u);
    sums[local] = value;
    barrier();

    // Each step adds the sum from offset places before: after log2(size) steps, every place holds its inclusive sum.
    for (uint offset = 1u; offset < CAMERA_CULL_GROUP_SIZE; offset *= 2u) {
        uvec2 before = local >= offset ? sums[local - offset] : uvec2(0u);
        barrier();
        sums[local] += before;
        barrier();
    }

    if (place < viewWork.visibleCandidates) {
        offsets[slice] = sums[local] - value;
    }

    if (local == CAMERA_CULL_GROUP_SIZE - 1) {
        blockSums[view.slices.y + gl_WorkGroupID.x] = sums[local];
    }

    if (local < CULL_LEVEL_SLOTS && levelCounts[local] > 0u) {
        atomicAdd(counts[view.view * CAMERA_CULL_COUNTS + local], levelCounts[local]);
    }
}
