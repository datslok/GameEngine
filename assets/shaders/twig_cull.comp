#version 450
#extension GL_GOOGLE_include_directive : require

/*
* The twig passes' second (render/vulkan/vulkan_twig_drawing.h; mirrored by twigDrawsOnCpu): a workgroup a source's
* brick (x the brick within its set, y the source), a thread a twig. The brick kept (twigBrickKept), each twig kept
* (twigKept), its level walked to the one it draws (twigLevelDrawn), its entry put in the region of its level's
* cluster count. A tree posed by its bones this frame culls its bricks and twigs by their posed bounds (twigBrickPose,
* twigPose). The regions' order is the atomics', so the cluster passes and cluster-compare take them as sets.
*
* The tally (F4's TWIGS line, TwigTally) is counted in shared memory and added once a workgroup, so a frame's million
* twigs do not all meet at the same few words.
*/
#include "twig_pass.glsl"

layout(local_size_x = TWIG_BRICK_SIZE) in;

shared uint groupTally[TWIG_TALLY_WORDS];

void main() {
    uvec2 source = twigSources[gl_WorkGroupID.y];
    uvec4 set = twigSets[source.y];

    // The same for the whole workgroup, so no thread is left waiting at the barriers below.
    if (gl_WorkGroupID.x >= set.y) {
        return;
    }

    uint local = gl_LocalInvocationID.x;

    if (local < uint(TWIG_TALLY_WORDS)) {
        groupTally[local] = 0u;
    }

    barrier();

    TwigBrick brick = twigBricks[set.x + gl_WorkGroupID.x];
    uvec2 placed = placedEntries[source.x];
    PlacedPlant plant = placedPlants[placed.x & DRAW_LIST_INSTANCE_MASK];
    InstanceData part = placedInstance(placedPartInstances[placed.y], plant);
    CullRecord record = placedCullRecord(placedParts[placed.y].record, plant);
    BoneTree tree = boneCullTree(placed.x & DRAW_LIST_INSTANCE_MASK, push.boneStamp);
    MeshClusterPose brickPose = twigBrickPose(brick, part, placedParts[placed.y].unused1 != 0u, tree);

    if (local < brick.twigCount && twigBrickKept(brick, part, placed.x, record, view, brickPose)) {
        uint number = brick.firstTwig + local;
        Twig twig = twigs[number];
        TwigPrototype prototype = twigPrototypes[twig.prototype];
        InstanceData placedTwig = twigInstance(part, twig);
        TwigLevel coarsest = twigLevels[prototype.firstLevel + prototype.levelCount - 1u];
        uint binding = number < uint(boneCullTwigBindings.length()) ? boneCullTwigBindings[number] : SWAY_UNBOUND;
        MeshClusterPose pose = twigPose(coarsest.sphere, part, twig, binding, tree);

        if (twigKept(coarsest, placedTwig, placed.x, record, view, pose)) {
            uint chosen = prototype.levelCount - 1u;

            for (uint level = 0u; level < prototype.levelCount; ++level) {
                TwigLevel before = twigLevels[prototype.firstLevel + max(level, 1u) - 1u];

                if (twigLevelDrawn(before, level == 0u, twigLevels[prototype.firstLevel + level], placedTwig.model, view.levels)) {
                    chosen = level;
                    break;
                }
            }

            TwigLevel drawn = twigLevels[prototype.firstLevel + chosen];
            uint region = drawn.clusterCount - 1u;
            uint slot = atomicAdd(twigCounts[region], 1u);

            if (slot < twigRoom.x) {
                twigEntries[region * twigRoom.x + slot] = uvec4(source.x, number, drawn.firstCluster, 0u);
            }

            atomicAdd(groupTally[TWIG_TALLY_KEPT], 1u);
            atomicAdd(groupTally[TWIG_TALLY_LEVEL_TWIGS + chosen], 1u);
            atomicAdd(groupTally[TWIG_TALLY_LEVEL_TRIANGLES + chosen], drawn.triangleCount);

            if (pose.posed || meshClusterSeenWhole(part, placed.x, record, view, pose)) {
                atomicAdd(groupTally[TWIG_TALLY_SWAYING], 1u);
            }
        }
    }

    barrier();

    if (local == 0u) {
        groupTally[TWIG_TALLY_TESTED] = brick.twigCount;
    }

    barrier();

    if (local < uint(TWIG_TALLY_WORDS) && groupTally[local] != 0u) {
        atomicAdd(twigTally[local], groupTally[local]);
    }
}
