#version 450
#extension GL_GOOGLE_include_directive : require

/*
* One level of screen-space reflections' colour pyramid (render/gpu/screen_reflections.h), one invocation per texel:
* level 0 is last frame's finished picture at the render size, each level above the average of the 2x2 texels below
* (one bilinear read between them). Rough reflections read the level as wide as their cone.
*/
#include "render/gpu/screen_reflections_shared.h"

layout(local_size_x = SSR_GROUP_SIDE, local_size_y = SSR_GROUP_SIDE) in;

layout(set = 0, binding = 0) uniform sampler2D source;                // last frame's picture, or the level below; bilinear, clamped
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D level; // the level written

// Must match GpuPyramidPass.
layout(push_constant) uniform Pass {
    ivec4 target; // xy: this level's size, z: the level
    ivec4 source; // xy: the source's size
} pass;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);

    if (texel.x >= pass.target.x || texel.y >= pass.target.y) {
        return;
    }

    vec2 uv = (vec2(texel) + 0.5) / vec2(pass.target.xy);
    imageStore(level, texel, vec4(max(textureLod(source, uv, 0.0).rgb, vec3(0.0)), 1.0));
}
