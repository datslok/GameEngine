#version 450
#extension GL_GOOGLE_include_directive : require

/*
* Mesh clusters' culling, pass 3 of 4 (render/vulkan/vulkan_mesh_cluster_culling.h): one workgroup sums the blocks'
* survivors into each block's first place (a prefix sum carried between rounds, the total after the last), then writes
* the totals: pairs tested, survivors, and each style's run (from its first block's first place to the next style's),
* cut to the room, and each run's mesh shader draw; the survivors' triangles and candidates started at none for the
* write pass; the list's first place in the items. Each list its own totals and task commands. Mirrored by
* cullMeshClustersOnCpu.
*/
#include "mesh_cluster_pass.glsl"

layout(local_size_x = MESH_CLUSTER_GROUP_SIZE) in;

layout(std430, set = 0, binding = 12) readonly buffer BlockCounts {
    uint blockCounts[];
};

// Each block's first place, then the total.
layout(std430, set = 0, binding = 13) coherent buffer BlockFirst {
    uint blockFirst[];
};

// MESH_CLUSTER_TOTAL_WORDS.
layout(std430, set = 0, binding = 14) writeonly buffer Totals {
    uint totals[];
};

// Each style's mesh shader draw (VkDrawMeshTasksIndirectCommandEXT: x y z workgroups).
layout(std430, set = 0, binding = 15) writeonly buffer TaskCommands {
    uint taskCommands[];
};

shared uint sums[MESH_CLUSTER_GROUP_SIZE];

void main() {
    uint local = gl_LocalInvocationIndex;
    uint blocks = min(work[MESH_CLUSTER_WORK_END] / MESH_CLUSTER_GROUP_SIZE, setup.y);
    uint carried = 0u;

    // The loop's bounds are the same for the whole workgroup, so its barriers are reached by every invocation.
    for (uint first = 0u; first < blocks; first += MESH_CLUSTER_GROUP_SIZE) {
        uint block = first + local;
        uint value = block < blocks ? blockCounts[block] : 0u;
        sums[local] = value;
        barrier();

        for (uint offset = 1u; offset < MESH_CLUSTER_GROUP_SIZE; offset *= 2u) {
            uint before = local >= offset ? sums[local - offset] : 0u;
            barrier();
            sums[local] += before;
            barrier();
        }

        if (block < blocks) {
            blockFirst[block] = carried + sums[local] - value;
        }

        carried += sums[MESH_CLUSTER_GROUP_SIZE - 1u];
        barrier();
    }

    uint totalsFirst = listTotals();

    if (local == 0u) {
        blockFirst[blocks] = carried;
        totals[totalsFirst + MESH_CLUSTER_TOTAL_TESTED] = work[MESH_CLUSTER_WORK_REAL];
        totals[totalsFirst + MESH_CLUSTER_TOTAL_KEPT] = carried;
        totals[totalsFirst + MESH_CLUSTER_TOTAL_TRIANGLES] = 0u;
        totals[totalsFirst + MESH_CLUSTER_TOTAL_LIST_FIRST] = pass.list * setup.z;
        totals[totalsFirst + MESH_CLUSTER_TOTAL_CANDIDATES] = 0u;
    }

    // Every first place written before the runs read them.
    memoryBarrierBuffer();
    barrier();

    if (local < MESH_CLUSTER_STYLES) {
        uint room = setup.z;
        uint firstBlock = min(work[MESH_CLUSTER_WORK_STYLE_FIRST + local] / MESH_CLUSTER_GROUP_SIZE, blocks);
        uint endBlock = min(work[MESH_CLUSTER_WORK_STYLE_FIRST + local + 1u] / MESH_CLUSTER_GROUP_SIZE, blocks);
        uint runFirst = min(blockFirst[firstBlock], room);
        uint runCount = min(blockFirst[endBlock], room) - runFirst;
        totals[totalsFirst + MESH_CLUSTER_TOTAL_RUN_FIRST + local] = runFirst;
        totals[totalsFirst + MESH_CLUSTER_TOTAL_RUN_COUNT + local] = runCount;
        uvec3 groups = meshClusterTaskGroups(runCount);
        uint command = 3u * (pass.list * MESH_CLUSTER_STYLES + local);
        taskCommands[command] = groups.x;
        taskCommands[command + 1u] = groups.y;
        taskCommands[command + 2u] = groups.z;
    }
}
