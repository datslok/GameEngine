#version 460
#extension GL_GOOGLE_include_directive : require

// The multiple scattering table (render/gpu/atmosphere.h, multipleScatteringTexel): one workgroup per texel, one
// invocation per direction (multipleScatteringDirection), summed in order by the first. Made when the atmosphere changes.
#include "atmosphere.glsl"

layout(local_size_x = ATMOSPHERE_MULTIPLE_SCATTERING_DIRECTIONS) in;

layout(std430, set = 0, binding = 0) readonly buffer AtmosphereData {
    Atmosphere atmosphere;
} data;

layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D multipleScatteringTable;

shared vec3 luminances[ATMOSPHERE_MULTIPLE_SCATTERING_DIRECTIONS];
shared vec3 scatteredOnce[ATMOSPHERE_MULTIPLE_SCATTERING_DIRECTIONS];

void main() {
    ivec2 texel = ivec2(gl_WorkGroupID.xy);
    int index = int(gl_LocalInvocationIndex);
    AtmosphereRay ray = multipleScatteringLutRay(data.atmosphere, (vec2(texel) + 0.5) / float(ATMOSPHERE_MULTIPLE_SCATTERING_SIZE));
    ScatteringMarch march = multipleScatteringDirection(data.atmosphere, ray.radius, ray.cosZenith, index);
    luminances[index] = march.luminance;
    scatteredOnce[index] = march.multipleScatteringAs1;

    barrier();

    if (index == 0) {
        vec3 luminanceSum = vec3(0.0);
        vec3 onceSum = vec3(0.0);

        for (int direction = 0; direction < ATMOSPHERE_MULTIPLE_SCATTERING_DIRECTIONS; ++direction) {
            luminanceSum += luminances[direction];
            onceSum += scatteredOnce[direction];
        }

        imageStore(multipleScatteringTable, texel, vec4(multipleScatteringFromSums(luminanceSum, onceSum), 1.0));
    }
}
