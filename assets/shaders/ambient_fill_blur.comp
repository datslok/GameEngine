#version 460
#extension GL_GOOGLE_include_directive : require

/*
* Ambient occlusion's fill blurred (render/gpu/ambient_occlusion.h, AoLight's fill parts), always while it gathers: one
* of two passes, across then down (the push constant's direction), each pixel the mean of AO_FILL_BLUR_TAPS texels each
* way AO_FILL_BLUR_STRIDE apart, each weighted by how near its view distance is to the pixel's (aoBlurWeight), so the
* fill of a surface in front does not bleed onto one behind. Both parts (the light above the surface and the coverage)
* are blurred alike, so the main pass's ratio of them stays a ratio of averages. The view distances come from the depth
* (the sky, at no distance, is left out).
*/
#include "screen_reflections.glsl"
#include "ambient_occlusion.glsl"

layout(local_size_x = AO_GROUP_SIDE, local_size_y = AO_GROUP_SIDE) in;

// The occlusion pass's record (GpuAmbientOcclusionPass): only the camera and the size are read here.
layout(std430, set = 0, binding = 0) readonly buffer Pass {
    mat4 inverseViewProjection;
    vec4 size;
} pass;

layout(set = 0, binding = 1) uniform sampler2D depth;                     // exact texels
layout(set = 0, binding = 2) uniform sampler2D source;                    // the fill's parts so far
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D blurred;  // the same, blurred along the direction

layout(push_constant) uniform Direction {
    ivec4 direction; // xy: one texel along the blur
};

// The view distance at a texel, 0 for the sky.
float distanceAt(ivec2 texel) {
    float texelDepth = texelFetch(depth, texel, 0).r;
    return texelDepth == float(GPU_FAR_DEPTH) ? 0.0 : viewDistanceAtPixel(pass.inverseViewProjection, vec2(texel) + 0.5, texelDepth, pass.size.xy);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(pass.size.xy);

    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    float centre = distanceAt(texel);

    if (centre <= 0.0) {
        imageStore(blurred, texel, vec4(0.0));
        return;
    }

    vec4 sum = vec4(0.0);
    float weights = 0.0;

    for (int tap = -AO_FILL_BLUR_TAPS; tap <= AO_FILL_BLUR_TAPS; ++tap) {
        ivec2 at = texel + direction.xy * (tap * AO_FILL_BLUR_STRIDE);

        if (any(lessThan(at, ivec2(0))) || any(greaterThanEqual(at, size))) {
            continue;
        }

        float atDistance = distanceAt(at);

        if (atDistance <= 0.0) {
            continue;
        }

        float weight = aoBlurWeight(centre, atDistance);
        sum += texelFetch(source, at, 0) * weight;
        weights += weight;
    }

    // The pixel itself always weighs 1, so weights is never 0.
    imageStore(blurred, texel, sum / weights);
}
