#version 450
#extension GL_GOOGLE_include_directive : require

/*
* The bones passes' first (render/vulkan/vulkan_bone_posing.h): a workgroup a (group of a part moved by bones, swaying
* view), a thread an entry of that view's group. A plant within the sway's reach is claimed once a frame by its stamp;
* the thread that claims it takes the next tree, room for its bones in the pool (none when they do not fit: it stands
* still) and raises the pose pass's dispatch to hold the tree. The order trees are numbered in is the atomics', not fixed;
* nothing a tree's poses depend on comes from its number.
*/
#include "bone_pass.glsl"
#include "instances.glsl"

layout(local_size_x = BONE_GROUP_SIZE) in;

void main() {
    uint group = workList[swayingViewCount + gl_WorkGroupID.x];
    uint view = workList[gl_WorkGroupID.y];
    DrawCommand command = placedCommands[view * groupsAView + group];
    uint first = command.firstInstance - PLACED_INSTANCE_BASE;

    for (uint instance = gl_LocalInvocationID.x; instance < command.instanceCount; instance += BONE_GROUP_SIZE) {
        uvec2 entry = placedEntries[first + instance];
        uint plant = drawnInstance(entry.x);

        // Taken already this frame (the common case: a tree's parts and views), or out of reach: nothing to do.
        if (plantTrees[2u * plant] == push.stamp || !boneTreeWanted(placedPlants[plant].foot, push.eye.xyz, push.fadeEnd)) {
            continue;
        }

        if (atomicExchange(plantTrees[2u * plant], push.stamp) == push.stamp) {
            continue;
        }

        uint tree = atomicAdd(boneHeader[BONE_HEADER_TREES], 1u);

        if (tree >= uint(BONE_MOST_TREES)) {
            plantTrees[2u * plant + 1u] = BONE_NO_TREE;
            continue;
        }

        uint skeleton = placedParts[entry.y].unused1 - 1u;
        uint bones = swaySkeletons[skeleton].boneCount;
        uint asked = atomicAdd(boneHeader[BONE_HEADER_BONES_ASKED], bones);
        uint firstPose = boneTreeFirstPose(asked, bones, push.poolBones);

        if (firstPose == BONE_NO_POSE) {
            atomicAdd(boneHeader[BONE_HEADER_TREES_STILL], 1u);
        }

        boneTrees[tree] = BoneTree(plant, skeleton, firstPose, 0.0, vec4(0.0));
        plantTrees[2u * plant + 1u] = tree;
        atomicMax(boneHeader[BONE_HEADER_DISPATCH], tree + 1u);
    }
}
