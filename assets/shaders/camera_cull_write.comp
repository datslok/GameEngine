#version 450
#extension GL_GOOGLE_include_directive : require

/*
* The GPU culling's write pass (render/vulkan/vulkan_camera_culling.h): each flagged visible candidate writes its draw
* list entry at its place (its block's first place plus its offset), with its thinned bit and fade field (the fading
* ones' worked out again from their records); each group writes its indirect commands from the places at its two ends
* (its first segment's first visible candidate, and past its last segment's). Dispatched indirectly, one invocation a
* visible candidate or group, whichever are more, and view (the dispatch's y), in that view's slices and draw list
* regions.
*/
#include "render/gpu/instance_shared.h"
#include "camera_culling.glsl"

layout(local_size_x = CAMERA_CULL_GROUP_SIZE) in;

layout(std430, set = 0, binding = 0) readonly buffer Views {
    CameraCull views[];
};

layout(std430, set = 0, binding = 1) readonly buffer Candidates {
    CullCandidate candidates[];
};

layout(std430, set = 0, binding = 2) readonly buffer Flags {
    uint flags[];
};

layout(std430, set = 0, binding = 3) readonly buffer Offsets {
    uvec2 offsets[];
};

layout(std430, set = 0, binding = 4) readonly buffer BlockSums {
    uvec2 blockFirst[];
};

layout(std430, set = 0, binding = 5) readonly buffer Groups {
    CullGroup groups[];
};

// The frame's draw list (instances.glsl's), each view's regions written here.
layout(std430, set = 0, binding = 6) writeonly buffer DrawList {
    uint drawList[];
};

layout(std430, set = 0, binding = 7) writeonly buffer MainCommands {
    DrawCommand mainCommands[];
};

layout(std430, set = 0, binding = 8) writeonly buffer MotionCommands {
    DrawCommand motionCommands[];
};

layout(std430, set = 0, binding = 9) readonly buffer SegmentOffsets {
    uvec2 segmentOffsets[];
};

layout(std430, set = 0, binding = 10) readonly buffer SegmentBlockFirst {
    uvec2 segmentBlockFirst[];
};

layout(std430, set = 0, binding = 11) readonly buffer Work {
    CullViewWork work[];
};

// The draws' records and the meshes' levels, for the fade field of the candidates flagged fading (cameraCandidateEntry).
layout(std430, set = 0, binding = 12) readonly buffer Records {
    CullRecord records[];
};

layout(std430, set = 0, binding = 13) readonly buffer Levels {
    MeshLevels meshLevels[];
};

// A visible candidate's place in both of the view's lists; past the last, the totals.
uvec2 placeOf(CameraCull view, CullViewWork viewWork, uint visible) {
    return visible >= viewWork.visibleCandidates ? blockFirst[view.slices.y + viewWork.candidateBlocks]
                                                 : blockFirst[view.slices.y + visible / CAMERA_CULL_GROUP_SIZE] + offsets[view.slices.x + visible];
}

// A segment's first place among the visible candidates; past the last segment, their total.
uint segmentStart(CameraCull view, uint segment) {
    return segment >= view.segments ? segmentBlockFirst[view.segmentSlices.y + view.segmentBlocks].x
                                    : segmentBlockFirst[view.segmentSlices.y + segment / CAMERA_CULL_GROUP_SIZE].x + segmentOffsets[view.segmentSlices.x + segment].x;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    CameraCull view = views[gl_WorkGroupID.y];
    CullViewWork viewWork = work[view.view];

    if (index < viewWork.visibleCandidates) {
        uint packedFlags = flags[view.slices.x + index];
        uint candidateFlags = packedFlags & ((1u << CAMERA_CULL_FLAG_BITS) - 1u);

        if (candidateFlags != 0u) {
            uvec2 place = placeOf(view, viewWork, index);
            CullCandidate candidate = candidates[packedFlags >> CAMERA_CULL_FLAG_BITS];
            uint fade = 0u;

            if ((candidateFlags & CAMERA_CULL_FADES) != 0u) {
                CullRecord record = records[candidate.draw];
                fade = cameraCandidateFade(record, meshLevels[record.mesh], view, candidate.slot);
            }

            uint entry = cameraCandidateEntry(candidate.draw, candidateFlags, fade);

            if ((candidateFlags & CAMERA_CULL_DRAWN) != 0u) {
                drawList[view.mainBase + place.x] = entry;
            }

            if ((candidateFlags & CAMERA_CULL_MOVING) != 0u) {
                drawList[view.motionBase + place.y] = entry;
            }
        }
    }

    if (index < view.groups) {
        CullGroup group = groups[index];
        uvec2 start = placeOf(view, viewWork, segmentStart(view, group.firstSegment));
        uvec2 end = placeOf(view, viewWork, segmentStart(view, group.firstSegment + group.segments));
        uint command = view.slices.z + index;
        mainCommands[command] = DrawCommand(group.indexCount, end.x - start.x, group.firstIndex, group.vertexOffset, view.mainBase + start.x);
        motionCommands[command] = DrawCommand(group.indexCount, end.y - start.y, group.firstIndex, group.vertexOffset, view.motionBase + start.y);
    }
}
