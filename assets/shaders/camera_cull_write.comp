#version 450
#extension GL_GOOGLE_include_directive : require

/*
* The camera's GPU culling, pass 3 of 3 (render/vulkan/vulkan_camera_culling.h): each flagged candidate writes its draw
* list entry at its place (its block's first place plus its offset), with its thinned bit; each group writes its
* indirect commands from the places at its two ends. One invocation a candidate or group, whichever are more.
*/
#include "render/gpu/instance_shared.h"
#include "camera_culling.glsl"

layout(local_size_x = CAMERA_CULL_GROUP_SIZE) in;

// Must match GpuCullGroup.
struct Group {
    uint firstCandidate;
    uint candidates;
    uint indexCount;
    uint unused;
};

// Must match GpuDrawCommand (VkDrawIndexedIndirectCommand).
struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 0) readonly buffer View {
    CameraCull view;
};

layout(std430, set = 0, binding = 1) readonly buffer Candidates {
    CullCandidate candidates[];
};

layout(std430, set = 0, binding = 2) readonly buffer Flags {
    uint flags[];
};

layout(std430, set = 0, binding = 3) readonly buffer Offsets {
    uvec2 offsets[];
};

layout(std430, set = 0, binding = 4) readonly buffer BlockSums {
    uvec2 blockFirst[];
};

layout(std430, set = 0, binding = 5) readonly buffer Groups {
    Group groups[];
};

// The frame's draw list (instances.glsl's), its camera and velocity regions written here.
layout(std430, set = 0, binding = 6) writeonly buffer DrawList {
    uint drawList[];
};

layout(std430, set = 0, binding = 7) writeonly buffer MainCommands {
    DrawCommand mainCommands[];
};

layout(std430, set = 0, binding = 8) writeonly buffer MotionCommands {
    DrawCommand motionCommands[];
};

// A candidate's place in both lists; past the last candidate, the totals.
uvec2 placeOf(uint candidate) {
    return candidate >= view.candidates ? blockFirst[view.blocks] : blockFirst[candidate / CAMERA_CULL_GROUP_SIZE] + offsets[candidate];
}

void main() {
    uint index = gl_GlobalInvocationID.x;

    if (index < view.candidates) {
        uint candidateFlags = flags[index];

        if (candidateFlags != 0u) {
            uvec2 place = placeOf(index);
            uint entry = candidates[index].draw | ((candidateFlags & CAMERA_CULL_THINNED) != 0u ? DRAW_LIST_THINNED_BIT : 0u);

            if ((candidateFlags & CAMERA_CULL_DRAWN) != 0u) {
                drawList[view.mainBase + place.x] = entry;
            }

            if ((candidateFlags & CAMERA_CULL_MOVING) != 0u) {
                drawList[view.motionBase + place.y] = entry;
            }
        }
    }

    if (index < view.groups) {
        Group group = groups[index];
        uvec2 start = placeOf(group.firstCandidate);
        uvec2 end = placeOf(group.firstCandidate + group.candidates);
        mainCommands[index] = DrawCommand(group.indexCount, end.x - start.x, 0u, 0, view.mainBase + start.x);
        motionCommands[index] = DrawCommand(group.indexCount, end.y - start.y, 0u, 0, view.motionBase + start.y);
    }
}
