#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

/*
* The placed drawing's scan (render/vulkan/vulkan_placed_drawing.h): a workgroup a (group, view) turns the group's count
* in each of the view's items into the item's first place within the view's group (an exclusive prefix sum over its
* items, a workgroup's worth at a time carried on), and writes the view's group's total.
*/
#include "placed_cull.glsl"

layout(local_size_x = PLACED_SCAN_GROUP_SIZE) in;

shared uint sums[PLACED_SCAN_GROUP_SIZE];

void main() {
    uint local = gl_LocalInvocationIndex;
    uint group = gl_WorkGroupID.x;
    uint viewNumber = gl_WorkGroupID.y;
    PlacedView view = placedViews[viewNumber];
    uint groups = view.groups;
    uint carried = 0u;

    // The loop's bounds are the same for the whole workgroup, so its barriers are reached by every invocation.
    for (uint first = 0u; first < view.items; first += PLACED_SCAN_GROUP_SIZE) {
        uint item = view.firstItem + first + local;
        bool held = first + local < view.items;
        uint value = held ? placedBlockCounts[item * groups + group] : 0u;
        sums[local] = value;
        barrier();

        for (uint offset = 1u; offset < PLACED_SCAN_GROUP_SIZE; offset *= 2u) {
            uint before = local >= offset ? sums[local - offset] : 0u;
            barrier();
            sums[local] += before;
            barrier();
        }

        if (held) {
            placedBlockCounts[item * groups + group] = carried + sums[local] - value;
        }

        carried += sums[PLACED_SCAN_GROUP_SIZE - 1];
        barrier();
    }

    if (local == 0u) {
        placedTotals[viewNumber * groups + group] = carried;
    }
}
