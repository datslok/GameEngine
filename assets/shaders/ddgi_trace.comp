#version 460
#extension GL_GOOGLE_include_directive : require

/*
* The light probes' rays (render/gpu/ddgi.h): one invocation per ray, each traced from its probe against the frame's
* solid instances (the glowing stand-ins for lights are left out, since their light is counted directly), and what it
* brings back written for the update: the light leaving the surface it hit, towards the probe, and its distance.
* - a miss brings back the sky behind everything (the background, and the atmosphere's sky in its direction), at the
*   ray's whole reach;
* - a back face (the probe sees the inside of something) brings back no light, its distance recorded negative;
* - a front face brings back its own glow, plus, on its base colour (matte only: the probes' cosine averaging blurs away
*   gloss [2019]):
*   - the direct light of every directional light that reaches it, and of the brightest few point and spot lights near
*     the probes (render/gpu/ddgi_sampling.h, probeHitLights), each found by a shadow ray: the shadow atlas only holds
*     what the camera sees, so it cannot answer for hits off screen;
*   - the light from all around as last frame's probes hold it (the flat ambient beyond the volume), times the bounce
*     energy setting: each frame passes on one more bounce, so a still scene gathers every bounce over time.
* Light from fast lights (flashlights) is kept apart for the fast atlas: their direct light at the hit, and their light
* as last frame's fast atlas holds it, so their later bounces keep its short memory too. Probes within reach of a fast
* light trace the fast count of rays (render/gpu/ddgi.h, probeNearLight); the dispatch has room for the most any probe
* traces (the stride), and the rest of a probe's room is skipped. Only awake and vigilant probes trace, from where
* relocation moved them (scene_probe_states.glsl).
*/
#include "ray_scene.glsl"
#include "materials.glsl"
#include "instances.glsl"
#include "frame_data.glsl"
#include "scene_lights.glsl"
#include "ddgi.glsl"
#include "ddgi_volume.glsl"
#include "scene_probes.glsl"

layout(local_size_x = DDGI_TRACE_GROUP_SIZE) in;

// One vec4 per ray, stride rays a probe: rgb the light brought back from still lights, a the distance (negative for a
// back face).
layout(std430, set = 3, binding = 0) writeonly buffer ProbeRays {
    vec4 probeRays[];
};

// The light brought back from fast lights, the same layout, packed as half floats (packFastRayLight).
layout(std430, set = 3, binding = 1) writeonly buffer FastProbeRays {
    uvec2 fastProbeRays[];
};

// Per probe, 1 if a fast light is within reach this frame: the update reads which rays it traced from it.
layout(std430, set = 3, binding = 2) writeonly buffer ProbeNearFastLights {
    int probeNearFastLight[];
};

layout(std430, set = 3, binding = 3) readonly buffer ProbeTurns {
    ProbeTurn probeTurns[];
};

// The point lights, then the spotlights, whose light may reach the probes' rays' hits: x numbers into the light buffers,
// y 1 for a fast light (render/gpu/ddgi_sampling.h, GpuProbeHitLight).
layout(std430, set = 1, binding = 14) readonly buffer ProbeHitLights {
    ivec2 probeHitLights[];
};

// Whether nothing solid lies between a point and a light along toLight within reach: the first hit anywhere settles it.
bool reachesLight(vec3 from, vec3 toLight, float reach) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, rayScene, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, RAY_MASK_SOLID, from, 0.0, toLight, reach);

    while (rayQueryProceedEXT(query)) {
    }

    return rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT;
}

// Listed light number of the hit lights: its position and range, measured from the camera (as the light buffers are).
vec4 hitLightPositionRange(int listed) {
    int light = probeHitLights[listed].x;
    return listed < probeLights.x ? points[light].positionRange : spots[light].positionRange;
}

// Listed light number of the hit lights' offset from a surface, both measured from the camera.
vec3 hitLightOffset(int listed, vec3 relativeHit) {
    return hitLightPositionRange(listed).xyz - relativeHit;
}

// Whether a fast light listed for the hits is within reach of the probe (probeNearLight), both measured from the camera;
// reach is the longest distance the probe's cascade records.
bool anyFastLightNear(vec3 probe, float reach) {
    for (int listed = 0; listed < probeLights.x + probeLights.y; ++listed) {
        if (probeHitLights[listed].y == 0) {
            continue;
        }

        vec4 light = hitLightPositionRange(listed);

        if (probeNearLight(probe, light.xyz, light.w, reach)) {
            return true;
        }
    }

    return false;
}

// The irradiance listed light number gives the surface, before its shadow ray.
vec3 hitLightIrradiance(int listed, vec3 relativeHit, vec3 normal) {
    int light = probeHitLights[listed].x;
    vec3 offset = hitLightOffset(listed, relativeHit);

    if (listed < probeLights.x) {
        PointLightData point = points[light];
        return pointLightAtHit(offset, point.positionRange.w, point.radiance.rgb, point.radiance.w, normal);
    }

    SpotLightData spot = spots[light];
    return spotLightAtHit(offset, spot.positionRange.w, spot.radianceCosInner.rgb, spot.sourceRadius, spot.directionCosOuter.xyz,
                          spot.directionCosOuter.w, spot.radianceCosInner.w, normal);
}

void main() {
    int stride = volume.counts.w;
    int index = int(gl_GlobalInvocationID.x);
    int probe = index / stride;
    int ray = index % stride;

    // Off and sleeping probes are not traced (render/gpu/probe_relocation.h); the rest from where relocation moved them.
    if (probe >= volumeProbeCount() || !probeTraced(probeStates[probe].state)) {
        return;
    }

    // Rays leave from the probe in the world; everything else here is measured from the camera, as the cascades are.
    ProbeCascade cascade = probeCascades[volumeCascadeOf(probe)];
    vec3 relativeOrigin = cascadeProbePosition(cascade, volume.counts.xyz, probe) + probeStates[probe].offset;
    vec3 origin = relativeOrigin + cameraOrigin.xyz;
    bool nearFastLight = anyFastLightNear(relativeOrigin, cascade.origin.w);
    int rays = volumeRayCount(nearFastLight);

    if (ray == 0) {
        probeNearFastLight[probe] = nearFastLight ? 1 : 0;
    }

    if (ray >= rays) {
        return;
    }

    vec3 direction = volumeRayDirection(ray, rays, probeTurns[probe]);

    // No minimum distance: a probe cannot hit itself, and skipping near hits lets rays slip through walls [2021].
    rayQueryEXT query;
    rayQueryInitializeEXT(query, rayScene, gl_RayFlagsOpaqueEXT, RAY_MASK_SOLID, origin, 0.0, direction, DDGI_RAY_REACH);

    while (rayQueryProceedEXT(query)) {
    }

    if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
        probeRays[index] = vec4(volume.sky.rgb + skyLightTowards(direction), DDGI_RAY_REACH);
        fastProbeRays[index] = packFastRayLight(vec3(0.0));
        return;
    }

    float distance = rayQueryGetIntersectionTEXT(query, true);

    if (!rayQueryGetIntersectionFrontFaceEXT(query, true)) {
        probeRays[index] = vec4(0.0, 0.0, 0.0, -distance);
        fastProbeRays[index] = packFastRayLight(vec3(0.0));
        return;
    }

    InstanceData instance = instances[rayQueryGetIntersectionInstanceCustomIndexEXT(query, true)];
    MeshSurface surface = meshSurfaceAt(instance.material.y, rayQueryGetIntersectionPrimitiveIndexEXT(query, true),
                                        rayQueryGetIntersectionBarycentricsEXT(query, true));
    vec3 normal = normalize(mat3(instance.normalMatrix) * surface.normal);

    // The face was met from its front, so its shading normal should face the ray too; smoothing can tip it past.
    if (dot(normal, direction) > 0.0) {
        normal = -normal;
    }

    MaterialData material = materials[instance.material.x];
    vec3 albedo = textureLod(textures[nonuniformEXT(material.textureSlots.x)], surface.uv, 0.0).rgb * material.baseColour.rgb;
    vec3 hit = origin + direction * distance;
    vec3 shadowFrom = hit + normal * DDGI_SHADOW_RAY_OFFSET;
    vec3 irradiance = vec3(0.0);

    for (int i = 0; i < counts.x; ++i) {
        vec3 toLight = directional[i].toLight.xyz;
        float facing = dot(normal, toLight);

        if (facing > 0.0 && reachesLight(shadowFrom, toLight, DDGI_RAY_REACH)) {
            irradiance += directional[i].radiance.rgb * facing;
        }
    }

    // The brightest point and spot lights here, then a shadow ray to each (to its centre: its glowing stand-in is not solid).
    vec3 relativeHit = hit - cameraOrigin.xyz;
    BrightestLights kept;
    kept.count = 0;

    for (int listed = 0; listed < probeLights.x + probeLights.y; ++listed) {
        keepBrightestLight(kept, probeLights.z, listed, hitLightStrength(hitLightIrradiance(listed, relativeHit, normal)));
    }

    vec3 fastIrradiance = vec3(0.0);

    for (int slot = 0; slot < kept.count; ++slot) {
        int listed = kept.lights[slot];
        vec3 offset = hitLightOffset(listed, relativeHit + normal * DDGI_SHADOW_RAY_OFFSET);
        float lightDistance = length(offset);

        if (lightDistance > 0.0 && reachesLight(shadowFrom, offset / lightDistance, lightDistance)) {
            if (probeHitLights[listed].y != 0) {
                fastIrradiance += hitLightIrradiance(listed, relativeHit, normal);
            } else {
                irradiance += hitLightIrradiance(listed, relativeHit, normal);
            }
        }
    }

    // Last frame's probes at the hit, every cascade; each atlas's light passed on into its own.
    ProbeLights bounced = probeAmbient(relativeHit, normal, normal, normal, -direction, 0, false);
    irradiance += bounced.still.diffuse * probeShading.y;
    fastIrradiance += bounced.fast.diffuse * probeShading.y;

    probeRays[index] = vec4(material.emissive.rgb + albedo * irradiance, distance);
    fastProbeRays[index] = packFastRayLight(albedo * fastIrradiance);
}
