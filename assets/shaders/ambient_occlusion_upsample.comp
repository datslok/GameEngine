#version 460
#extension GL_GOOGLE_include_directive : require

/*
* Ambient occlusion at half resolution (render/gpu/ambient_occlusion.h, aoUpsampleAt mirrors it), one invocation per
* render pixel, last: the half-size result brought to the render's size for the main pass. Each pixel's point (from its
* own depth, read through the half-size passes' shifted inverse at aoHalfPlace) weighs the four texels round it by their
* bilinear shares and by how near it lies to each texel's surface plane, so light never crosses from one surface to
* another; on none of their planes, it takes the texel nearest it in view depth. The sky, and pixels whose texels are
* all open, stay open.
*/
#include "screen_reflections.glsl"
#include "ambient_occlusion.glsl"

layout(local_size_x = AO_GROUP_SIDE, local_size_y = AO_GROUP_SIDE) in;

// Must match GpuAmbientOcclusionPass: the half-size passes' record.
layout(std430, set = 0, binding = 0) readonly buffer Pass {
    mat4 inverseViewProjection; // shifted onto the frame's picked pixels
    vec4 size;                  // xy: the half-size grid in pixels
    vec4 lens;
    vec4 options;
    ivec4 frame;                // yz: the pick
    mat4 reprojection;
    vec4 gather;
    vec4 history;
    vec4 denoise;               // y: the plane share
} pass;

layout(set = 0, binding = 1) uniform sampler2D depth;                     // the render's depths, exact texels
layout(set = 0, binding = 2) uniform sampler2D geometry;                  // half-size: xyz the normal, w the view depth (0 open)
layout(set = 0, binding = 3) uniform sampler2D source;                    // half-size: the light gathered and the visibility
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D upsampled;

layout(push_constant) uniform Render {
    ivec4 render; // xy: the render's size
};

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);

    if (texel.x >= render.x || texel.y >= render.y) {
        return;
    }

    vec4 open = vec4(0.0, 0.0, 0.0, 1.0);
    float pixelDepth = texelFetch(depth, texel, 0).r;

    if (pixelDepth == float(GPU_FAR_DEPTH)) {
        imageStore(upsampled, texel, open);
        return;
    }

    ivec2 halfGrid = ivec2(pass.size.xy);
    vec2 place = aoHalfPlace(vec2(texel) + 0.5, vec2(render.xy), pass.size.xy, aoHalfShift(pass.frame.yz));
    vec3 point = positionAtPixel(pass.inverseViewProjection, place, pixelDepth, pass.size.xy);
    float viewDepth = viewDistanceAtPixel(pass.inverseViewProjection, place, pixelDepth, pass.size.xy);
    vec2 base = floor(place - 0.5);
    vec2 fraction = place - 0.5 - base;
    vec4 sum = vec4(0.0);
    float weights = 0.0;
    vec4 nearest = open;
    float nearestGap = 1e30;

    for (int tap = 0; tap < 4; ++tap) {
        ivec2 at = clamp(ivec2(base) + ivec2(tap & 1, tap >> 1), ivec2(0), halfGrid - 1);
        vec4 tapGeometry = texelFetch(geometry, at, 0);

        if (tapGeometry.w <= 0.0) {
            continue;
        }

        vec4 tapLight = texelFetch(source, at, 0);
        float gap = abs(tapGeometry.w - viewDepth);

        if (gap < nearestGap) {
            nearestGap = gap;
            nearest = tapLight;
        }

        vec3 tapPoint = aoDepthRay(pass.inverseViewProjection, vec2(at) + 0.5, pass.size.xy) * tapGeometry.w;
        float weight = aoTapWeight(fraction, tap) * aoPlaneWeight(tapGeometry.xyz, tapPoint, point, tapGeometry.w, pass.denoise.y);
        sum += tapLight * weight;
        weights += weight;
    }

    imageStore(upsampled, texel, weights >= float(AO_UPSAMPLE_LEAST_WEIGHT) ? sum / weights : nearest);
}
